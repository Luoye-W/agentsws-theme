{% doc %}
  @description Country / currency and language selectors (Shopify Markets) as one form that submits as soon as a value changes and returns the shopper to the same page. Each selector only appears when the store offers more than one option; nothing is output otherwise. Full variant shows visible labels; compact variant hides labels visually (screen readers still read them) for bars and headers.
  Use when: header, announcement bar, menu drawer, footer — anywhere a country or language switch is needed. The localization block wraps this snippet for the editor.

  @param {string} form_id - Unique id for the form (e.g. "HeaderLocalization")
  @param {boolean} [show_country] - Show the country/currency selector, default true
  @param {boolean} [show_language] - Show the language selector, default true
  @param {boolean} [compact] - Smaller controls with visually hidden labels
  @param {string} [class] - Extra classes on the form

  @example
  {% render 'localization-form', form_id: 'HeaderLocalization', compact: true %}
{% enddoc %}
{%- liquid
  assign want_country = true
  if show_country == false
    assign want_country = false
  endif
  assign want_language = true
  if show_language == false
    assign want_language = false
  endif

  assign has_country = false
  if want_country and localization.available_countries.size > 1
    assign has_country = true
  endif
  assign has_language = false
  if want_language and localization.available_languages.size > 1
    assign has_language = true
  endif

  if compact
    assign label_class = 'sr-only'
    assign select_class = 'h-9 appearance-none rounded-input border border-border bg-transparent ps-3 pe-8 type-xs'
    assign form_class = 'flex flex-wrap items-center gap-2'
  else
    assign label_class = 'type-xs text-muted'
    assign select_class = 'h-10 appearance-none rounded-input border border-border bg-bg ps-3 pe-9 type-sm'
    assign form_class = 'flex flex-wrap items-end gap-3'
  endif
  if class != blank
    assign form_class = form_class | append: ' ' | append: class
  endif
-%}
{%- if has_country or has_language -%}
  <aw-localization class="block">
    {%- form 'localization', id: form_id, class: form_class -%}
      {%- if has_country -%}
        <div class="flex flex-col gap-1">
          <label for="{{ form_id }}-country" class="{{ label_class }}">{{ 'sections.localization.country' | t }}</label>
          <div class="relative">
            <select id="{{ form_id }}-country" name="country_code" class="{{ select_class }}">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', name: 'chevron-down', class: 'pointer-events-none absolute top-1/2 end-2.5 size-4 -translate-y-1/2' -%}
          </div>
        </div>
      {%- endif -%}
      {%- if has_language -%}
        <div class="flex flex-col gap-1">
          <label for="{{ form_id }}-language" class="{{ label_class }}">{{ 'sections.localization.language' | t }}</label>
          <div class="relative">
            <select id="{{ form_id }}-language" name="locale_code" class="{{ select_class }}">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                  {{- language.endonym_name | capitalize -}}
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', name: 'chevron-down', class: 'pointer-events-none absolute top-1/2 end-2.5 size-4 -translate-y-1/2' -%}
          </div>
        </div>
      {%- endif -%}
      <noscript><button type="submit" class="btn btn-secondary min-h-10">{{ 'sections.localization.update' | t }}</button></noscript>
    {%- endform -%}
  </aw-localization>
  <script src="{{ 'c-localization.js' | asset_url }}" type="module"></script>
{%- endif -%}
