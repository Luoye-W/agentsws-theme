{% doc %}
  @description List of links to the store's social media accounts (Theme settings → Social media: Instagram, Facebook, X, YouTube, TikTok, Pinterest, Snapchat, LinkedIn, Discord, Threads, Twitch, WhatsApp). Only accounts with a URL are shown; nothing is output when none are set. The glyphs are simplified outlines drawn for this theme (24px grid, currentColor), not official brand artwork, so they follow the text color of any surface.
  Use when: footer, announcement bar, menu drawer, "follow us" rows. For the editor-placeable version use the social-links block.

  @param {string} [class] - Classes for the list, default "flex flex-wrap items-center gap-1"
  @param {string} [icon_class] - Size classes for each glyph, default "size-5"
  @param {string} [link_class] - Classes for each link, default "flex size-11 items-center justify-center rounded-btn hover:bg-fg/5"

  @example
  {% render 'social-icons', icon_class: 'size-6' %}
{% enddoc %}
{%- liquid
  assign list_class = class | default: 'flex flex-wrap items-center gap-1'
  assign glyph_class = icon_class | default: 'size-5'
  assign anchor_class = link_class | default: 'flex size-11 items-center justify-center rounded-btn hover:bg-fg/5'
  assign networks = 'instagram,facebook,x,youtube,tiktok,pinterest,snapchat,linkedin,discord,threads,twitch,whatsapp' | split: ','

  assign has_any = false
  for network in networks
    assign key = 'social_' | append: network
    if settings[key] != blank
      assign has_any = true
      break
    endif
  endfor
-%}
{%- if has_any -%}
  <ul class="{{ list_class }}" role="list">
    {%- for network in networks -%}
      {%- assign key = 'social_' | append: network -%}
      {%- assign url = settings[key] -%}
      {%- if url != blank -%}
        {%- liquid
          case network
            when 'x'
              assign network_name = 'X'
            when 'youtube'
              assign network_name = 'YouTube'
            when 'tiktok'
              assign network_name = 'TikTok'
            when 'linkedin'
              assign network_name = 'LinkedIn'
            when 'whatsapp'
              assign network_name = 'WhatsApp'
            else
              assign network_name = network | capitalize
          endcase
        -%}
        <li>
          <a href="{{ url | escape }}" class="{{ anchor_class }}" target="_blank" rel="noopener me">
            <svg class="{{ glyph_class }} shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {%- case network -%}
                {%- when 'instagram' -%}
                  <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>
                {%- when 'facebook' -%}
                  <path d="M15 3.5h-2.2A3.8 3.8 0 0 0 9 7.3v13.2M6.5 11H14"/>
                {%- when 'x' -%}
                  <path d="M4 4h4.3l11.7 16h-4.3z"/><path d="M19.5 4l-6.4 7M4.5 20l6.4-7"/>
                {%- when 'youtube' -%}
                  <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor"/>
                {%- when 'tiktok' -%}
                  <path d="M13.5 3.5v11.3a3.7 3.7 0 1 1-3.7-3.7"/><path d="M13.5 3.5c.4 2.6 2.4 4.6 5 4.8"/>
                {%- when 'pinterest' -%}
                  <circle cx="12" cy="12" r="8.5"/><path d="M11.2 11l-2 9"/><path d="M9.6 14.2c-1.4-3.6.8-6.7 3.5-6.7 2.4 0 3.9 1.8 3.4 4.3-.4 2.2-1.9 3.6-3.9 3.2"/>
                {%- when 'snapchat' -%}
                  <path d="M12 3.5c2.9 0 5 2.2 5 5v2.4l1.9.4-1.4 1.6c.7 1.5 1.8 2.5 3 3-1.4.8-2.9.7-3.4 1.4-.5.7-.9 1.5-1.9 1.1-1.7-.7-2.7.6-3.2 1.1-.5-.5-1.5-1.8-3.2-1.1-1 .4-1.4-.4-1.9-1.1-.5-.7-2-.6-3.4-1.4 1.2-.5 2.3-1.5 3-3l-1.4-1.6 1.9-.4V8.5c0-2.8 2.1-5 5-5z"/>
                {%- when 'linkedin' -%}
                  <rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.5v6M8 7.6v.1M12 16.5v-6M12 13.2a2.6 2.6 0 0 1 5.2 0v3.3"/>
                {%- when 'discord' -%}
                  <path d="M8.5 6.5c2.3-.7 4.7-.7 7 0 1.8 2.6 2.8 5.8 2.6 9.3-1.4 1.1-2.9 1.7-4.3 2l-.9-1.6M8.5 6.5C6.7 9.1 5.7 12.3 5.9 15.8c1.4 1.1 2.9 1.7 4.3 2l.9-1.6M8.3 15.3c2.4.9 5 .9 7.4 0"/><circle cx="9.8" cy="12" r="1"/><circle cx="14.2" cy="12" r="1"/>
                {%- when 'threads' -%}
                  <circle cx="12" cy="12" r="3"/><path d="M15 12v1.5a2.5 2.5 0 0 0 5 0V12a8 8 0 1 0-3.2 6.4"/>
                {%- when 'twitch' -%}
                  <path d="M4.5 3.5h15v10l-4 4H12l-3 3v-3H4.5z"/><path d="M10.5 7.5v4M15 7.5v4"/>
                {%- when 'whatsapp' -%}
                  <path d="M4 20l1.2-3.9A8.5 8.5 0 1 1 8.1 19z"/><path d="M9 8.5c0 3.4 3 6.4 6.5 6.5l1-1.6-2-1-1 .9c-1.2-.5-2.4-1.7-2.9-2.9l.9-1-1-2z"/>
              {%- endcase -%}
            </svg>
            <span class="sr-only">{{ network_name }}</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
