{% doc %}
  @description Turns Theme settings into CSS custom properties, font faces and one ".surface-<scheme id>" class per color scheme. Rendered once inside <head> by layout files. --c-* = colors of the current scheme (any element with a surface class), --p-* = global status colors, --s-* = layout, typography and component settings. Tailwind tokens in src/tailwind.css read these variables, so settings changes apply without rebuilding CSS.

  @example
  {% render 'theme-tokens' %}
{% enddoc %}
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

  assign heading_family = heading_font.family | append: ', ' | append: heading_font.fallback_families
  assign body_family = body_font.family | append: ', ' | append: body_font.fallback_families
  if settings.heading_custom_font != blank
    assign heading_family = '"aw-heading-custom", ' | append: heading_family
  endif
  if settings.body_custom_font != blank
    assign body_family = '"aw-body-custom", ' | append: body_family
  endif

  if settings.nav_font == 'heading'
    assign nav_font = heading_font
    assign nav_family = 'var(--s-font-heading)'
  else
    assign nav_font = body_font
    assign nav_family = 'var(--s-font-body)'
  endif
  if settings.button_font == 'heading'
    assign button_font = heading_font
    assign button_family = 'var(--s-font-heading)'
  else
    assign button_font = body_font
    assign button_family = 'var(--s-font-body)'
  endif
  if settings.card_font == 'heading'
    assign card_font = heading_font
    assign card_family = 'var(--s-font-heading)'
  else
    assign card_font = body_font
    assign card_family = 'var(--s-font-body)'
  endif
  assign nav_face = nav_font | font_modify: 'weight', settings.nav_weight
  assign button_face = button_font | font_modify: 'weight', settings.button_weight
  assign card_face = card_font | font_modify: 'weight', settings.card_weight

  assign overlay_alpha = settings.overlay_opacity | divided_by: 100.0
  assign shadow_alpha = settings.button_shadow_opacity | divided_by: 100.0
-%}
{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}
  {{ nav_face | font_face: font_display: 'swap' }}
  {{ button_face | font_face: font_display: 'swap' }}
  {{ card_face | font_face: font_display: 'swap' }}
  {%- if settings.heading_custom_font != blank -%}
    @font-face { font-family: "aw-heading-custom"; src: url("{{ settings.heading_custom_font | file_url }}"); font-display: swap; font-weight: 100 900; }
  {%- endif -%}
  {%- if settings.body_custom_font != blank -%}
    @font-face { font-family: "aw-body-custom"; src: url("{{ settings.body_custom_font | file_url }}"); font-display: swap; font-weight: 100 900; }
  {%- endif -%}

  {%- for scheme in settings.color_schemes -%}
    {%- liquid
      assign cs = scheme.settings
      if cs.background_gradient != blank
        assign gradient = cs.background_gradient
      else
        assign gradient = 'none'
      endif
    -%}
    .surface-{{ scheme.id }}{% if scheme.id == settings.body_color_scheme %}, :root{% endif %} {
      --c-bg: {{ cs.background }};
      --c-bg-image: {{ gradient }};
      --c-fg: {{ cs.foreground }};
      --c-primary: {{ cs.primary }};
      --c-on-primary: {{ cs.on_primary }};
      --c-accent: {{ cs.accent }};
      --c-on-accent: {{ cs.on_accent }};
    }
  {%- endfor -%}

  :root {
    --p-sale: {{ settings.color_sale }};
    --p-badge-sale-bg: {{ settings.color_badge_sale_bg }};
    --p-badge-sale-fg: {{ settings.color_badge_sale_text }};
    --p-rating: {{ settings.color_rating }};
    --p-success: {{ settings.color_success }};
    --p-error: {{ settings.color_error }};
    --p-focus: {{ settings.color_focus }};
    --p-overlay: {{ settings.color_overlay | color_modify: 'alpha', overlay_alpha }};
    --p-placeholder: {{ settings.color_placeholder }};
    --p-shadow: {{ settings.color_shadow | color_modify: 'alpha', shadow_alpha }};

    --s-font-heading: {{ heading_family }};
    --s-font-heading-weight: {{ heading_font.weight }};
    --s-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --s-heading-leading: {{ settings.heading_line_height | divided_by: 100.0 }};
    --s-heading-tracking: {{ settings.heading_letter_spacing | divided_by: 1000.0 }}em;
    --s-heading-case: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --s-font-body: {{ body_family }};
    --s-font-body-weight: {{ body_font.weight }};
    --s-body-size: {{ settings.body_size }};
    --s-body-leading: {{ settings.body_line_height | divided_by: 100.0 }};
    --s-body-tracking: {{ settings.body_letter_spacing | divided_by: 1000.0 }}em;

    --s-nav-font: {{ nav_family }};
    --s-nav-weight: {{ settings.nav_weight }};
    --s-nav-size: {{ settings.nav_size | divided_by: 16.0 }}rem;
    --s-nav-case: {% if settings.nav_uppercase %}uppercase{% else %}none{% endif %};
    --s-button-font: {{ button_family }};
    --s-button-weight: {{ settings.button_weight }};
    --s-button-size: {{ settings.button_size | divided_by: 16.0 }}rem;
    --s-button-tracking: {{ settings.button_letter_spacing | divided_by: 1000.0 }}em;
    --s-button-case: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
    --s-card-font: {{ card_family }};
    --s-card-weight: {{ settings.card_weight }};
    --s-card-size: {{ settings.card_size | divided_by: 16.0 }}rem;
    --s-card-case: {% if settings.card_uppercase %}uppercase{% else %}none{% endif %};
    --s-icon-stroke: {{ settings.icon_stroke | divided_by: 10.0 }};

    --s-page-width: {{ settings.page_width }}px;
    --s-gutter: {{ settings.gutter_mobile }}px;
    --s-section-scale: {{ settings.section_spacing | divided_by: 100.0 }};
    --s-grid-gap: {{ settings.grid_gap_mobile }}px;
    --s-radius-card: {{ settings.radius_card }}px;
    --s-radius-media: {{ settings.radius_media }}px;
    --s-radius-input: {{ settings.radius_input }}px;
    --s-radius-btn: {{ settings.radius_button }}px;
    --s-radius-swatch: {% case settings.swatch_shape %}{% when 'square' %}0px{% when 'rounded' %}25%{% else %}9999px{% endcase %};
    --s-btn-border: {{ settings.button_border }}px;
    --s-btn-cut: {{ settings.button_corner_cut }}px;
    --s-btn-shadow: {% if settings.button_shadow_opacity > 0 %}{{ settings.button_shadow_x }}px {{ settings.button_shadow_y }}px 0 var(--p-shadow){% else %}none{% endif %};
    --s-input-border: {{ settings.input_border }}px;
    --s-logo-width: {{ settings.logo_width }}px;
    --s-logo-width-mobile: {{ settings.logo_width_mobile }}px;
    --s-logo-max-height: {{ settings.logo_max_height }}px;
  }

  @media (min-width: 750px) {
    :root {
      --s-gutter: {{ settings.gutter_desktop }}px;
      --s-grid-gap: {{ settings.grid_gap_desktop }}px;
    }
  }
{%- endstyle -%}
