{% doc %}
  @description Cart line items: image, title, variant options, line price (with discounts), quantity stepper and remove link. Quantity inputs keep the native `updates[]` name so the cart page also works without JavaScript. The "table" layout (cart page) puts quantity and line total in their own columns from tablet up and shows the unit price and vendor under the title.
  Use when: inside <aw-cart-items> in the cart drawer or on the cart page.

  @param {string} section_id - Id of the rendering section, keeps input ids unique
  @param {string} [image_sizes] - The sizes attribute for line images, default "96px"
  @param {string} [layout] - "compact" (default: price beside the title, quantity below) or "table" (columns for quantity and line total from 750px)
  @param {boolean} [show_vendor] - Show the product vendor above the title

  @example
  {% render 'cart-lines', section_id: section.id, image_sizes: '120px' %}
{% enddoc %}
{%- liquid
  assign line_image_sizes = image_sizes | default: '96px'
  assign is_table = false
  if layout == 'table'
    assign is_table = true
  endif
-%}
<ul class="flex flex-col divide-y divide-border" role="list">
  {%- for item in cart.items -%}
    <li class="flex gap-4 py-4">
      <a href="{{ item.url }}" class="block w-20 shrink-0 overflow-hidden rounded-card bg-fg/5 md:w-24" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{
            item.image
            | image_url: width: 240
            | image_tag: widths: '96, 160, 240', sizes: line_image_sizes, class: 'aspect-square w-full object-contain', alt: '', loading: 'lazy'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'aspect-square w-full' }}
        {%- endif -%}
      </a>
      <div class="flex min-w-0 flex-1 flex-col gap-2 {% if is_table %}md:grid md:grid-cols-[minmax(0,1fr)_auto_8rem] md:items-center md:gap-6{% endif %}">
        <div class="flex items-start justify-between gap-3">
          <div class="flex min-w-0 flex-col gap-1">
            {%- if show_vendor and item.vendor != blank -%}
              <p class="type-xs text-muted">{{ item.vendor | escape }}</p>
            {%- endif -%}
            <a href="{{ item.url }}" class="font-medium no-underline hover:underline">{{ item.product.title | escape }}</a>
            {%- if is_table -%}
              <p class="type-sm">
                {%- if item.original_price != item.final_price -%}
                  <s class="me-1 text-muted">{{ item.original_price | money }}</s>
                {%- endif -%}
                {{- item.final_price | money -}}
              </p>
            {%- endif -%}
            {%- unless item.product.has_only_default_variant -%}
              <p class="type-sm text-muted">
                {%- for option in item.options_with_values -%}
                  {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
                {%- endfor -%}
              </p>
            {%- endunless -%}
            {%- if item.selling_plan_allocation -%}
              <p class="type-sm text-muted">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
            {%- endif -%}
            {%- for discount in item.line_level_discount_allocations -%}
              <p class="type-xs text-sale">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
            {%- endfor -%}
          </div>
          <div class="shrink-0 text-end {% if is_table %}hidden{% endif %}">
            {%- if item.original_line_price != item.final_line_price -%}
              <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
              <s class="block type-xs text-muted">{{ item.original_line_price | money }}</s>
              <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
            {%- endif -%}
            <span class="font-semibold">{{ item.final_line_price | money }}</span>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <aw-quantity class="inline-flex h-10 items-center rounded-input border border-border">
            <button type="button" class="flex size-10 items-center justify-center" data-ref="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}">
              {%- render 'icon', name: 'minus', class: 'size-4' -%}
            </button>
            <input
              type="number"
              name="updates[]"
              data-ref="input"
              id="CartLine-{{ section_id }}-{{ forloop.index }}"
              value="{{ item.quantity }}"
              min="0"
              {% if item.variant.quantity_rule.max %}
                max="{{ item.variant.quantity_rule.max }}"
              {% endif %}
              step="{{ item.variant.quantity_rule.increment | default: 1 }}"
              data-line="{{ forloop.index }}"
              class="h-full w-10 border-0 bg-transparent text-center [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
              aria-label="{{ 'products.product.quantity.label_for' | t: product: item.product.title }}"
            >
            <button type="button" class="flex size-10 items-center justify-center" data-ref="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}">
              {%- render 'icon', name: 'plus', class: 'size-4' -%}
            </button>
          </aw-quantity>
          <a href="{{ item.url_to_remove }}" class="type-sm text-muted underline hover:text-fg" data-remove-line="{{ forloop.index }}">
            {{- 'general.cart.remove' | t -}}
            <span class="sr-only">{{ item.product.title | escape }}</span>
          </a>
          {%- if is_table -%}
            <span class="ms-auto font-semibold md:hidden">{{ item.final_line_price | money }}</span>
          {%- endif -%}
        </div>
        {%- if is_table -%}
          <div class="text-end max-md:hidden">
            {%- if item.original_line_price != item.final_line_price -%}
              <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
              <s class="block type-xs text-muted">{{ item.original_line_price | money }}</s>
              <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
            {%- endif -%}
            <span class="type-h6">{{ item.final_line_price | money }}</span>
          </div>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
