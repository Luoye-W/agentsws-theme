{% doc %}
  @description Compact horizontal product row: small image, vendor, title (the whole row links to the product), price and an optional round quick add button (adds single-variant products at once, opens quick view for products with options).
  Use when: short product lists inside other content — complementary products, "complete the look", drawers.

  @param {object} product - The product
  @param {boolean} [quick_add] - Show the quick add button (load c-quick-add.js on the page)
  @param {boolean} [show_vendor] - Show the vendor line

  @example
  {% render 'product-card-mini', product: product, quick_add: true %}
{% enddoc %}
{%- liquid
  assign image_alt = product.featured_media.alt | default: product.title | escape
-%}
<div class="relative flex items-center gap-3">
  <div class="size-20 shrink-0 overflow-hidden rounded-media bg-placeholder">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', class: 'size-full object-contain', alt: image_alt }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'size-full' }}
    {%- endif -%}
  </div>
  <div class="flex min-w-0 flex-1 flex-col gap-0.5">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="type-xs text-muted">{{ product.vendor | escape }}</p>
    {%- endif -%}
    <a href="{{ product.url }}" class="line-clamp-2 type-sm font-semibold no-underline after:absolute after:inset-0 hover:underline">
      {{- product.title | escape -}}
    </a>
    {% render 'price', product: product, size: 'sm' %}
  </div>
  {%- if quick_add -%}
    {% render 'quick-add', product: product, class: 'relative z-10 shrink-0' %}
  {%- endif -%}
</div>
