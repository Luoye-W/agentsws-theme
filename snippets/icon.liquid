{% doc %}
  @description Inline SVG icon from the theme's own small icon set (24px grid, stroke drawn with currentColor). Decorative: hidden from screen readers, so always pair with visible text or an aria-label on the control.
  Use when: header icons, drawer close buttons, chevrons, quantity steppers.
  Also: weight, plug, mic, waves, help, arrow-up.

  @param {string} name - menu, close, search, account, cart, chevron-down, chevron-left, chevron-right, arrow-right, plus, minus, filter, check, bluetooth, battery, bolt, shield, truck, return, water, headphones, speaker, chat, lock, star, globe, bag, trolley, home, grid, gift, tag, clock, heart, mail, phone, pause, play, share, link, box, map-pin, arrow-left, pin, info, ruler, zoom, leaf, eye, calendar, award, users, credit-card, package, sparkle, quote
  @param {string} [class] - Size/colour classes, default "size-5"

  @example
  {% render 'icon', name: 'cart', class: 'size-6' %}
{% enddoc %}
{%- liquid
  assign icon_class = class | default: 'size-5'
-%}
<svg class="{{ icon_class }} shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
