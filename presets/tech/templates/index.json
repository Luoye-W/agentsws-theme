    "featured": {
      "type": "featured-product",
      "settings": {
        "product": "brushed-steel-turntable",
        "gallery_layout": "slider",
        "thumbnail_position": "start",
        "media_width": "large",
        "badge_text": "Featured \u2022 Featured \u2022 Featured \u2022 ",
        "badge_icon": "star",
        "enable_zoom": true,
        "show_details_link": true,
        "padding_top": 72,
        "padding_bottom": 72
