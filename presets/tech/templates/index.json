    "intro": {
      "type": "container",
      "settings": {
        "direction": "row",
        "align": "start",
        "justify": "between",
        "gap": 48,
        "padding_top": 72,
        "padding_bottom": 56
      },
      "blocks": {
        "left": {
          "type": "group",
          "settings": {
            "width": "half",
            "gap": 24
          },
          "blocks": {
            "h": {
              "type": "heading",
              "settings": {
                "text": "We believe in the power of <em>sound</em>",
                "size": "h1",
                "tag": "h2",
                "alignment": "left"
              }
            },
            "b": {
              "type": "button",
              "settings": {
                "label": "Our story",
                "link": "shopify://pages/contact",
                "style": "secondary"
              }
            }
