          "block_order": [
            "h",
            "b"
          ]
        },
        "right": {
          "type": "group",
          "settings": {
            "width": "half",
            "gap": 16
          },
          "blocks": {
            "t": {
              "type": "text",
              "settings": {
                "text": "<p><strong>Demo store.</strong> This layout shows how the theme's sections recreate a full audio storefront: products, collections and imagery come from Shopify's sample catalogs.</p><p>Swap in your own brand story here.</p>",
                "size": "body",
                "muted": true,
                "alignment": "left"
              }
            }
          },
          "block_order": [
            "t"
          ]
        }
      },
      "block_order": [
        "left",
        "right"
      ]
    },
