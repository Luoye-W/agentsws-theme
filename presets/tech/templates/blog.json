{
  "sections": {
    "main": {
      "type": "main-blog",
      "settings": {
        "heading_size": "display",
        "heading_alignment": "center",
        "show_tag_filter": true,
        "tag_filter_style": "links",
        "tag_filter_mobile": "select",
        "layout": "collage",
        "lead_text_scheme": "scheme-3",
        "lead_overlay": 40,
        "columns_desktop": 3,
        "posts_per_page": 9,
        "image_ratio": "landscape",
        "show_tags": true,
        "tags_on_image": true,
        "show_date": true,
        "meta_icons": true,
        "show_author": false,
        "show_reading_time": false,
        "show_comments": true,
        "show_excerpt": true,
        "padding_top": 40,
        "padding_bottom": 72
      }
    },
    "services": {
      "type": "multicolumn",
      "settings": {
        "heading": "",
        "columns": 4,
        "columns_mobile": "2",
        "mobile_layout": "stack",
        "card_style": "plain",
        "icon_position": "start",
        "icon_size": 28,
        "padding_top": 32,
        "padding_bottom": 32
      },
      "blocks": {
        "c1": {
          "type": "_column",
          "settings": {
            "media": "icon",
            "icon": "chat",
            "heading": "Customer service",
            "text": "<p>Real people answer within one business day.</p>"
          }
        },
        "c2": {
          "type": "_column",
          "settings": {
            "media": "icon",
            "icon": "truck",
            "heading": "Shipping",
            "text": "<p>Describe your delivery promise here.</p>"
          }
        },
        "c3": {
          "type": "_column",
          "settings": {
            "media": "icon",
            "icon": "gift",
            "heading": "Refer a friend",
            "text": "<p>Explain your referral offer here.</p>"
          }
        },
        "c4": {
          "type": "_column",
          "settings": {
            "media": "icon",
            "icon": "lock",
            "heading": "Secure payment",
            "text": "<p>Payments are processed by Shopify.</p>"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3",
        "c4"
      ]
    }
  },
  "order": [
    "main",
    "services"
  ]
}
