        "b": {
          "type": "button",
          "settings": {
            "label": "Get directions",
            "link": "https://www.google.com/maps/search/?api=1&query=151+O%27Connor+St+Ottawa",
            "style": "secondary"
          }
        }
      },
      "block_order": [
        "h",
        "a",
        "o",
        "b"
      ]
