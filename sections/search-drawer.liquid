{% comment %}
  @description Search panel opened from the header search icon or the mobile dock (slides in from the side or drops from the top — Theme settings → Search). Shows suggested links while empty and, with predictive search on, live results as you type: query suggestions, products (image, title, optional vendor and price), collections, pages and articles. Arrow keys move through results, Enter opens one, Escape closes; the number of results is announced. Without JavaScript the form goes to the search page.
  Use when: never add to templates — the layout renders it when Theme settings → Search → Search type is "Drawer".
{% endcomment %}
{%- liquid
  if settings.search_drawer_position == 'top'
    assign dialog_class = 'm-0 mb-auto h-auto max-h-[85dvh] w-full max-w-none'
  else
    assign dialog_class = 'm-0 ms-auto h-dvh max-h-dvh w-full max-w-md'
  endif
  assign placeholder = settings.search_placeholder
  if placeholder == blank
    assign placeholder = 'general.search.placeholder' | t
  endif
  assign menu = settings.search_menu
-%}
<aw-drawer id="SearchDrawer">
  <dialog
    data-ref="dialog"
    class="{{ dialog_class }} surface-{{ settings.drawer_color_scheme }} p-0 backdrop:bg-[rgb(0_0_0/0.5)]"
    aria-labelledby="SearchDrawerHeading"
  >
    <aw-predictive-search
      class="flex h-full max-h-[inherit] flex-col"
      data-url="{{ routes.predictive_search_url }}"
      data-section="predictive-search"
      data-limit="{{ settings.search_results_limit }}"
      data-predictive="{{ settings.search_predictive }}"
      data-unsupported="{{ 'general.search.unsupported' | t | escape }}"
      data-error="{{ 'general.search.error' | t | escape }}"
    >
      <div class="flex items-center justify-between px-5 pt-3">
        <h2 id="SearchDrawerHeading" class="type-h5">{{ 'general.search.title' | t }}</h2>
        <button type="button" class="-me-2 flex size-11 items-center justify-center" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
          {%- render 'icon', name: 'close', class: 'size-6' -%}
        </button>
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="px-5 pt-2 pb-4">
        <input type="hidden" name="options[prefix]" value="last">
        <label for="SearchDrawerInput" class="sr-only">{{ 'general.search.label' | t }}</label>
        <div class="relative">
          <input
            type="search"
            id="SearchDrawerInput"
            name="q"
            class="field h-12 w-full ps-12 pe-20"
            placeholder="{{ placeholder | escape }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            autofocus
            data-ref="input"
            {% if settings.search_predictive %}
              role="combobox" aria-expanded="false" aria-controls="SearchDrawerResults" aria-autocomplete="list" aria-haspopup="listbox"
            {% endif %}
          >
          <button type="submit" class="absolute inset-y-0 start-0 flex w-12 items-center justify-center" aria-label="{{ 'general.search.submit' | t }}">
            {%- render 'icon', name: 'search', class: 'size-5' -%}
          </button>
          <button type="button" class="absolute inset-y-0 end-2 my-auto h-9 rounded-btn px-3 type-sm underline" data-ref="clear" hidden>
            {{- 'general.search.clear' | t -}}
          </button>
        </div>
      </form>
      <div class="min-h-0 flex-1 overflow-y-auto px-5 pb-6">
        {%- if menu.links.size > 0 -%}
          <div data-ref="suggestions" class="flex flex-col gap-6">
            <ul class="flex flex-col gap-1" role="list">
              {%- for link in menu.links -%}
                {%- if link.links.size == 0 -%}
                  <li><a href="{{ link.url }}" class="flex min-h-11 items-center type-h5 no-underline hover:underline">{{ link.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <div class="flex flex-col gap-2">
                  <h3 class="type-eyebrow text-muted">{{ link.title | escape }}</h3>
                  <ul class="flex flex-col" role="list">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}" class="flex min-h-11 items-center no-underline hover:underline">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div id="SearchDrawerResults" data-ref="results" role="listbox" aria-label="{{ 'general.search.results_label' | t }}" hidden></div>
        <p class="sr-only" role="status" data-ref="status"></p>
      </div>
    </aw-predictive-search>
  </dialog>
</aw-drawer>
<script src="{{ 'c-drawer.js' | asset_url }}" type="module"></script>
<script src="{{ 'c-predictive-search.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:sections.search_drawer.name",
  "class": "section-search-drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.search_drawer.settings.hint"
    }
  ]
}
{% endschema %}
