{% comment %}
  @description Cards linking to chosen collections: collection image (or its first product's image), title below or over the image, optional product count read out with the title and an optional subtitle (the collection description's first words, or one line of text for every card). Two card styles: plain (image with the title below or over it) and tile (a light panel with the image contained inside, the title with the product count as a small superscript number, the subtitle and an arrow). Grid or scrolling row on desktop, swipe row or stacked grid on mobile, with previous/next buttons when it scrolls. Optional heading group and a "View all" link to the collections page.
  Use when: "Shop by category / room / character" entry points on the home page or landing pages. For hand-made tiles with custom text use "image-cards".
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign heading_id = 'CollectionListHeading-' | append: section.id

  case s.columns
    when 2
      assign grid_cols = 'md:grid-cols-2'
    when 4
      assign grid_cols = 'md:grid-cols-3 lg:grid-cols-4'
    when 5
      assign grid_cols = 'md:grid-cols-3 lg:grid-cols-5'
    when 6
      assign grid_cols = 'md:grid-cols-3 lg:grid-cols-6'
    else
      assign grid_cols = 'md:grid-cols-3'
  endcase

  if s.columns_mobile == '2'
    assign mobile_cols = 'grid-cols-2'
    assign slide_width = '46%'
  else
    assign mobile_cols = 'grid-cols-1'
    assign slide_width = '80%'
  endif

  assign scroll_classes = 'snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]'
  if s.mobile_layout == 'slider' and s.layout == 'slider'
    assign list_class = 'flex gap-4 md:gap-6 -mx-(--s-gutter) px-(--s-gutter) scroll-px-(--s-gutter) md:mx-0 md:px-0 md:scroll-px-0 ' | append: scroll_classes
  elsif s.mobile_layout == 'slider'
    assign list_class = 'flex gap-4 -mx-(--s-gutter) px-(--s-gutter) scroll-px-(--s-gutter) md:mx-0 md:grid md:gap-6 md:overflow-visible md:px-0 ' | append: scroll_classes | append: ' ' | append: grid_cols
  elsif s.layout == 'slider'
    assign list_class = 'grid gap-4 md:flex md:gap-6 md:snap-x md:snap-mandatory md:overflow-x-auto md:[scrollbar-width:none] ' | append: mobile_cols
  else
    assign list_class = 'grid gap-4 md:gap-6 ' | append: mobile_cols | append: ' ' | append: grid_cols
  endif

  case s.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase

  assign view_all_label = ''
  assign view_all_link = ''
  if s.show_view_all
    assign view_all_label = 'sections.collection_list.view_all' | t
    assign view_all_link = routes.collections_url
  endif

  assign overlay = s.overlay_opacity | divided_by: 100.0
  assign placeholder_title = 'sections.collection_list.placeholder_title' | t

  if s.tile_image_fit == 'cover'
    assign tile_image_class = 'size-full rounded-media object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none'
  else
    assign tile_image_class = 'size-full object-contain transition duration-500 group-hover:scale-[1.04] motion-reduce:transition-none'
  endif
-%}
<div
  class="surface-{{ s.color_scheme }} pt-[calc(var(--section-pt)*0.75)] pb-[calc(var(--section-pb)*0.75)] md:pt-(--section-pt) md:pb-(--section-pb)"
  style="--section-pt: calc({{ s.padding_top }}px * var(--s-section-scale, 1)); --section-pb: calc({{ s.padding_bottom }}px * var(--s-section-scale, 1)); --card-ratio: {{ ratio }}; --card-overlay: {{ overlay }}; --per-view: {{ s.columns }}; --slide-w: {{ slide_width }};"
  data-layout="{{ s.layout }}"
  data-mobile="{{ s.mobile_layout }}"
>
  <div class="page-width flex flex-col gap-8 md:gap-10">
    {%- render 'section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      text: s.description,
      alignment: s.heading_alignment,
      link_label: view_all_label,
      link: view_all_link,
      heading_id: heading_id
    -%}
    <aw-slider class="flex flex-col gap-4">
      <ul
        class="{{ list_class }}"
        role="list"
        data-ref="track"
        {% if s.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- liquid
          assign cards = s.collections
          assign card_count = 0
          if s.collections != blank
            assign card_count = s.collections.size
          endif
          if card_count == 0
            assign cards = '1,2,3' | split: ','
          endif
        -%}
        {%- for card in cards -%}
          {%- liquid
            if card_count == 0
              assign card_title = placeholder_title
              assign card_url = ''
              assign card_image = nil
            else
              assign card_title = card.title | escape
              assign card_url = card.url
              assign card_image = card.featured_image
            endif
            assign placeholder_index = forloop.index | modulo: 6 | plus: 1
            assign placeholder_name = 'collection-' | append: placeholder_index

            assign card_subtitle = ''
            if s.subtitle_source == 'description' and card_count > 0
              assign card_subtitle = card.description | strip_html | strip | truncatewords: 8
            elsif s.subtitle_source == 'text'
              assign card_subtitle = s.subtitle_text | escape
            endif
            assign card_products = 0
            if s.show_count and card_count > 0
              assign card_products = card.all_products_count
            endif
          -%}
          <li class="shrink-0 snap-start max-md:in-data-[mobile=slider]:w-(--slide-w) md:in-data-[layout=slider]:w-[calc((100%-1.5rem*(min(var(--per-view),3)-1))/min(var(--per-view),3))] lg:in-data-[layout=slider]:w-[calc((100%-1.5rem*(var(--per-view)-1))/var(--per-view))]">
            {%- capture card_inner -%}
              {%- if s.card_style == 'tile' -%}
                <div class="flex aspect-(--card-ratio) items-center justify-center overflow-hidden">
                  {%- if card_image != blank -%}
                    {{ card_image | image_url: width: 1000 | image_tag: widths: '300, 450, 600, 800, 1000', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw', loading: 'lazy', class: tile_image_class, alt: '' }}
                  {%- else -%}
                    {{ placeholder_name | placeholder_svg_tag: 'size-full' }}
                  {%- endif -%}
                </div>
                <div class="mt-auto flex items-end justify-between gap-3">
                  <div class="flex min-w-0 flex-col gap-1">
                    <h3 class="type-h4">
                      {{- card_title -}}
                      {%- if card_products > 0 -%}
                        <sup class="ms-0.5 type-xs font-normal" aria-hidden="true">{{ card_products }}</sup>
                        <span class="sr-only">({{ 'sections.collection_list.product_count' | t: count: card_products }})</span>
                      {%- endif -%}
                    </h3>
                    {%- if card_subtitle != blank -%}
                      <p class="line-clamp-2 type-sm text-muted">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                  {%- render 'icon', name: 'arrow-right', class: 'size-5 shrink-0 transition group-hover:translate-x-1 motion-reduce:transition-none rtl:rotate-180' -%}
                </div>
              {%- else -%}
              <div class="relative isolate overflow-hidden rounded-media bg-fg/5 aspect-(--card-ratio)">
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw', loading: 'lazy', class: 'size-full object-cover transition duration-500 group-hover:scale-[1.04]', alt: '' }}
                {%- else -%}
                  {{ placeholder_name | placeholder_svg_tag: 'size-full bg-placeholder' }}
                {%- endif -%}
                {%- if s.title_position == 'overlay' -%}
                  <div class="absolute inset-0 bg-linear-to-t from-[rgb(0_0_0/var(--card-overlay))] to-transparent" aria-hidden="true"></div>
                  <div class="surface-{{ s.text_color_scheme }} absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-transparent p-4 md:p-5">
                    <div class="flex min-w-0 flex-col gap-1">
                      <h3 class="type-h4">
                        {{- card_title -}}
                        {%- if s.show_count and card_count > 0 -%}
                          <span class="type-sm ms-2 align-top font-normal opacity-80">{{ 'sections.collection_list.product_count' | t: count: card.all_products_count }}</span>
                        {%- endif -%}
                      </h3>
                      {%- if card_subtitle != blank -%}
                        <p class="line-clamp-2 type-sm opacity-80">{{ card_subtitle }}</p>
                      {%- endif -%}
                    </div>
                    {%- render 'icon', name: 'arrow-right', class: 'size-5 shrink-0 transition group-hover:translate-x-1 rtl:rotate-180' -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if s.title_position != 'overlay' -%}
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 flex-col gap-1">
                    <h3 class="type-h5 group-hover:underline">
                      {{- card_title -}}
                      {%- if s.show_count and card_count > 0 -%}
                        <span class="type-sm ms-2 font-normal text-muted">{{ 'sections.collection_list.product_count' | t: count: card.all_products_count }}</span>
                      {%- endif -%}
                    </h3>
                    {%- if card_subtitle != blank -%}
                      <p class="line-clamp-2 type-sm text-muted">{{ card_subtitle }}</p>
                    {%- endif -%}
                  </div>
                  {%- render 'icon', name: 'arrow-right', class: 'size-5 shrink-0 transition group-hover:translate-x-1 rtl:rotate-180' -%}
                </div>
              {%- endif -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if s.card_style == 'tile' -%}
              {%- assign card_class = 'group relative flex h-full flex-col gap-4 rounded-card bg-fg/5 p-4 no-underline md:p-6' -%}
            {%- else -%}
              {%- assign card_class = 'group relative flex flex-col gap-3 no-underline' -%}
            {%- endif -%}
            {%- if card_url != blank -%}
              <a href="{{ card_url }}" class="{{ card_class }}">{{ card_inner }}</a>
            {%- else -%}
              <div class="{{ card_class }}">{{ card_inner }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.layout == 'slider' or s.mobile_layout == 'slider' -%}
        {%- render 'slider-buttons', class: 'justify-end' -%}
      {%- endif -%}
    </aw-slider>
  </div>
</div>
{%- if s.layout == 'slider' or s.mobile_layout == 'slider' -%}
  <script src="{{ 'c-slider.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "section-collection-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.collection_list.settings.collections.label",
      "limit": 12
    },
    {
      "type": "header",
      "content": "t:shared.section_heading.header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.section_heading.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:shared.section_heading.heading",
      "default": "Shop by category"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:shared.section_heading.description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:shared.section_heading.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:shared.align.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.align.options.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.collection_list.settings.show_view_all.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.cards_header"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.collection_list.settings.card_style.label",
      "options": [
        {
          "value": "plain",
          "label": "t:sections.collection_list.settings.card_style.options.plain"
        },
        {
          "value": "tile",
          "label": "t:sections.collection_list.settings.card_style.options.tile"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "tile_image_fit",
      "label": "t:shared.fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:shared.fit.options.contain"
        },
        {
          "value": "cover",
          "label": "t:shared.fit.options.cover"
        }
      ],
      "default": "contain",
      "visible_if": "{{ section.settings.card_style == 'tile' }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.multicolumn.settings.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:shared.ratio.options.portrait"
        },
        {
          "value": "square",
          "label": "t:shared.ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:shared.ratio.options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "title_position",
      "label": "t:sections.collection_list.settings.title_position.label",
      "options": [
        {
          "value": "below",
          "label": "t:sections.collection_list.settings.title_position.options.below"
        },
        {
          "value": "overlay",
          "label": "t:sections.collection_list.settings.title_position.options.overlay"
        }
      ],
      "default": "below",
      "visible_if": "{{ section.settings.card_style == 'plain' }}"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection_list.settings.show_count.label",
      "default": false
    },
    {
      "type": "select",
      "id": "subtitle_source",
      "label": "t:sections.collection_list.settings.subtitle_source.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.collection_list.settings.subtitle_source.options.none"
        },
        {
          "value": "description",
          "label": "t:sections.collection_list.settings.subtitle_source.options.description"
        },
        {
          "value": "text",
          "label": "t:sections.collection_list.settings.subtitle_source.options.text"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "t:sections.collection_list.settings.subtitle_text.label",
      "info": "t:sections.collection_list.settings.subtitle_text.info",
      "visible_if": "{{ section.settings.subtitle_source == 'text' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.card_style == 'plain' and section.settings.title_position == 'overlay' }}"
    },
    {
      "type": "color_scheme",
      "id": "text_color_scheme",
      "label": "t:sections.hero.settings.text_surface.label",
      "info": "t:sections.hero.settings.text_surface.info",
      "default": "scheme-3",
      "visible_if": "{{ section.settings.card_style == 'plain' and section.settings.title_position == 'overlay' }}"
    },
    {
      "type": "header",
      "content": "t:shared.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_list.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.testimonials.settings.layout.options.grid"
        },
        {
          "value": "slider",
          "label": "t:sections.testimonials.settings.layout.options.slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:shared.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:shared.mobile_layout.label",
      "options": [
        {
          "value": "slider",
          "label": "t:shared.mobile_layout.options.slider"
        },
        {
          "value": "stack",
          "label": "t:shared.mobile_layout.options.stack"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:shared.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:shared.columns_mobile.options.one"
        },
        {
          "value": "2",
          "label": "t:shared.columns_mobile.options.two"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name"
    }
  ]
}
{% endschema %}
