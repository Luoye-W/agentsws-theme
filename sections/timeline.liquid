{% comment %}
  @description Milestones in order — each with a date or label, heading, text and an image or video (Shopify video or YouTube / Vimeo link, loaded only on click). Desktop: a horizontal scrolling row with previous/next buttons and an optional row of date buttons (above or below the row) that jump to each milestone; the next milestone can peek in at the edge. Card style "Image beside text" puts the media next to the text in a tinted card — one wide milestone at a time. Mobile: a vertical line with the milestones stacked.
  Use when: brand history ("Our story"), product generations, how an order is made, project or launch roadmaps.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign heading_id = 'TimelineHeading-' | append: section.id

  case s.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '16 / 9'
    else
      assign ratio = '3 / 2'
  endcase

  assign is_split = false
  if s.card_style == 'split'
    assign is_split = true
  endif
  if s.peek
    assign peek = '12%'
  else
    assign peek = '0px'
  endif
  if s.nav_position == 'bottom'
    assign nav_bar_class = 'border-t md:justify-between'
    assign nav_button_class = '-mt-px border-t-2'
  else
    assign nav_bar_class = 'border-b'
    assign nav_button_class = '-mb-px border-b-2'
  endif
-%}
<div
  class="surface-{{ s.color_scheme }} pt-[calc(var(--section-pt)*0.75)] pb-[calc(var(--section-pb)*0.75)] md:pt-(--section-pt) md:pb-(--section-pb)"
  style="--section-pt: calc({{ s.padding_top }}px * var(--s-section-scale, 1)); --section-pb: calc({{ s.padding_bottom }}px * var(--s-section-scale, 1)); --per-view: {{ s.items_desktop }}; --timeline-ratio: {{ ratio }}; --peek: {{ peek }};"
>
  <div class="page-width flex flex-col gap-8 md:gap-10">
    {%- render 'section-heading',
      eyebrow: s.eyebrow,
      heading: s.heading,
      text: s.description,
      alignment: s.heading_alignment,
      link_label: s.link_label,
      link: s.link,
      heading_id: heading_id
    -%}
    {%- capture nav_html -%}
      {%- if s.show_nav and section.blocks.size > 1 -%}
        <div class="hidden gap-2 overflow-x-auto border-border [scrollbar-width:none] md:flex {{ nav_bar_class }}" data-ref="nav-bar">
          {%- for item in section.blocks -%}
            {%- assign nav_label = item.settings.label | strip -%}
            <button
              type="button"
              class="{{ nav_button_class }} shrink-0 cursor-pointer border-transparent px-4 py-3 type-sm font-semibold text-muted transition hover:text-fg aria-[current=true]:border-fg aria-[current=true]:text-fg"
              data-ref="nav"
              data-index="{{ forloop.index0 }}"
            >
              {%- if nav_label != blank -%}
                {{ nav_label | escape }}
              {%- else -%}
                {{ forloop.index }}
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}
    <aw-slider class="flex flex-col gap-6">
      {%- if s.nav_position != 'bottom' -%}
        {{ nav_html }}
      {%- endif -%}
      <ol
        class="flex flex-col gap-10 border-s border-border ps-6 md:flex-row md:snap-x md:snap-mandatory md:gap-6 md:overflow-x-auto md:border-0 md:ps-0 md:pb-2 md:[scrollbar-width:thin]"
        data-ref="track"
        {% if s.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign image_alt = b.image.alt | escape
            assign video_label = b.video_description | default: b.heading | strip_html
          -%}
          <li
            class="relative flex flex-col gap-4 md:w-[calc((100%-1.5rem*(min(var(--per-view),2)-1)-var(--peek))/min(var(--per-view),2))] md:shrink-0 md:snap-start lg:w-[calc((100%-1.5rem*(var(--per-view)-1)-var(--peek))/var(--per-view))]"
            {{ block.shopify_attributes }}
          >
            <span class="absolute top-1 -start-[calc(1.5rem+6px)] size-3 rounded-full border-2 border-bg bg-fg md:hidden" aria-hidden="true"></span>
            {%- capture media_html -%}
            {%- if b.video != blank or b.video_url != blank -%}
              {%- render 'video-media', video: b.video, video_url: b.video_url, poster: b.image, description: video_label, ratio: 'var(--timeline-ratio)', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 90vw' -%}
            {%- elsif b.image != blank -%}
              <div class="overflow-hidden rounded-media bg-fg/5 aspect-(--timeline-ratio)">
                {{ b.image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1100, 1400', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 90vw', loading: 'lazy', class: 'size-full object-cover', alt: image_alt }}
              </div>
            {%- elsif request.design_mode -%}
              <div class="overflow-hidden rounded-media bg-fg/5 aspect-(--timeline-ratio)">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'size-full bg-placeholder' }}
              </div>
            {%- endif -%}
            {%- endcapture -%}
            {%- if is_split -%}
              <div class="grid h-full gap-4 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-6">
                {%- if media_html != blank -%}
                  <div class="min-w-0">{{ media_html }}</div>
                {%- endif -%}
                <div class="flex flex-col justify-center gap-3 rounded-card bg-fg/5 p-6 md:p-10 lg:p-14">
                  {%- if b.label != blank -%}
                    <p class="type-eyebrow text-muted">{{ b.label | escape }}</p>
                  {%- endif -%}
                  {%- if b.heading != blank -%}
                    <h3 class="type-h3">{{ b.heading }}</h3>
                  {%- endif -%}
                  {%- if b.text != blank -%}
                    <div class="rte text-muted">{{ b.text }}</div>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              {{ media_html }}
              <div class="flex flex-col gap-2">
                {%- if b.label != blank -%}
                  <p class="type-eyebrow text-muted">{{ b.label | escape }}</p>
                {%- endif -%}
                {%- if b.heading != blank -%}
                  <h3 class="type-h4">{{ b.heading }}</h3>
                {%- endif -%}
                {%- if b.text != blank -%}
                  <div class="rte text-muted">{{ b.text }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      {%- if s.nav_position == 'bottom' -%}
        {{ nav_html }}
      {%- endif -%}
      {%- render 'slider-buttons', class: 'justify-end' -%}
    </aw-slider>
  </div>
</div>
<script src="{{ 'c-slider.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:sections.timeline.name",
  "tag": "section",
  "class": "section-timeline",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "item",
      "name": "t:blocks.timeline_item.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:blocks.timeline_item.settings.label.label",
          "info": "t:blocks.timeline_item.settings.label.info",
          "default": "Step"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:shared.section_heading.heading",
          "default": "Add a milestone"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:blocks.text.settings.text.label",
          "default": "<p>Describe what happened or what comes next.</p>"
        },
        {
          "type": "header",
          "content": "t:blocks.timeline_item.settings.media_header"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:blocks.timeline_item.settings.image.label",
          "info": "t:blocks.timeline_item.settings.image.info"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:blocks.video.settings.video.label"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:blocks.video.settings.video_url.label",
          "accept": [
            "youtube",
            "vimeo"
          ]
        },
        {
          "type": "text",
          "id": "video_description",
          "label": "t:blocks.video.settings.description.label",
          "info": "t:blocks.video.settings.description.info"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "t:shared.section_heading.header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:shared.section_heading.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:shared.section_heading.heading",
      "default": "Our story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:shared.section_heading.description"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:shared.section_heading.alignment",
      "options": [
        {
          "value": "start",
          "label": "t:shared.align.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.align.options.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:shared.section_heading.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:shared.section_heading.link",
      "visible_if": "{{ section.settings.link_label != blank }}"
    },
    {
      "type": "header",
      "content": "t:shared.layout"
    },
    {
      "type": "range",
      "id": "items_desktop",
      "label": "t:sections.timeline.settings.items_desktop.label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "t:sections.timeline.settings.show_nav.label",
      "info": "t:sections.timeline.settings.show_nav.info",
      "default": true
    },
    {
      "type": "select",
      "id": "nav_position",
      "label": "t:sections.timeline.settings.nav_position.label",
      "options": [
        { "value": "top", "label": "t:sections.timeline.settings.nav_position.options.top" },
        { "value": "bottom", "label": "t:sections.timeline.settings.nav_position.options.bottom" }
      ],
      "default": "top",
      "visible_if": "{{ section.settings.show_nav }}"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.timeline.settings.card_style.label",
      "info": "t:sections.timeline.settings.card_style.info",
      "options": [
        { "value": "stacked", "label": "t:sections.timeline.settings.card_style.options.stacked" },
        { "value": "split", "label": "t:sections.timeline.settings.card_style.options.split" }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "peek",
      "label": "t:sections.timeline.settings.peek.label",
      "info": "t:sections.timeline.settings.peek.info",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.multicolumn.settings.image_ratio.label",
      "options": [
        {
          "value": "square",
          "label": "t:shared.ratio.options.square"
        },
        {
          "value": "portrait",
          "label": "t:shared.ratio.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:shared.ratio.options.landscape"
        },
        {
          "value": "wide",
          "label": "t:sections.multicolumn.settings.image_ratio.options.wide"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:sections.timeline.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "label": "Step 1",
            "heading": "Add a milestone"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Step 2",
            "heading": "Add a milestone"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Step 3",
            "heading": "Add a milestone"
          }
        },
        {
          "type": "item",
          "settings": {
            "label": "Step 4",
            "heading": "Add a milestone"
          }
        }
      ]
    }
  ]
}
{% endschema %}
