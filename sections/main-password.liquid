{% comment %}
  @description Password page shown while the store is closed: top bar with logo and an "Enter using password" button (the password form opens in a dialog that reopens by itself after a wrong password), heading and message (defaults to the password message from Preferences), optional email sign-up with a consent line (the form hides after signing up), optional background image with overlay, and a footer with "Powered by Shopify" and the store-owner login link.
  Use when: templates/password.json only.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
  assign surface = s.color_scheme
  if has_image
    assign surface = s.image_color_scheme
  endif
  assign message = s.text
  if message == blank and shop.password_message != blank
    assign message = '<p>' | append: shop.password_message | append: '</p>'
  endif

  if s.content_alignment == 'start'
    assign align_class = 'items-start text-start'
  else
    assign align_class = 'items-center text-center'
  endif

  assign password_has_errors = false
-%}
{%- capture password_form -%}
  {%- form 'storefront_password', class: 'flex w-full flex-col gap-4' -%}
    {%- if form.errors -%}
      {%- assign password_has_errors = true -%}
    {%- endif -%}
    {%- assign password_label = 'templates.password.label' | t -%}
    {%- assign password_error = form.errors.messages.password -%}
    {% render 'account-field',
      type: 'password',
      name: 'password',
      id: 'Password',
      label: password_label,
      autocomplete: 'current-password',
      required: true,
      error: password_error
    %}
    <button type="submit" class="btn btn-primary w-full">{{ 'templates.password.submit' | t }}</button>
  {%- endform -%}
{%- endcapture -%}
<div class="relative isolate flex min-h-svh flex-col surface-{{ surface }}">
  {%- if has_image -%}
    <div class="absolute inset-0 -z-10" style="--password-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};">
      {%- assign image_alt = s.image.alt | escape -%}
      {{
        s.image
        | image_url: width: 3000
        | image_tag: widths: '750, 1100, 1500, 1800, 2400, 3000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: image_alt, class: 'size-full object-cover'
      }}
      <div class="absolute inset-0 bg-[rgb(0_0_0/var(--password-overlay))]" aria-hidden="true"></div>
    </div>
  {%- endif -%}

  <header class="page-width flex items-center justify-between gap-4 bg-transparent py-5">
    <div class="flex flex-col gap-1">
      {%- if settings.logo != blank -%}
        {%- liquid
          assign logo = settings.logo
          if has_image and settings.logo_inverse != blank
            assign logo = settings.logo_inverse
          endif
          assign logo_alt = logo.alt | default: shop.name | escape
        -%}
        <span style="--logo-w: {{ settings.logo_width }}px; --logo-h: {{ settings.logo_max_height }}px;">
          {{
            logo
            | image_url: width: 600
            | image_tag: widths: '200, 300, 400, 600', sizes: '200px', alt: logo_alt, class: 'h-auto w-(--logo-w) max-h-(--logo-h) object-contain', loading: 'eager'
          }}
        </span>
      {%- else -%}
        <span class="type-h5">{{ shop.name | escape }}</span>
      {%- endif -%}
    </div>
    <button type="button" class="btn btn-secondary bg-bg/10 backdrop-blur-sm" data-modal-open="PasswordDialog" aria-haspopup="dialog">
      {%- render 'icon', name: 'lock', class: 'size-5 max-md:hidden' -%}
      {{- 'templates.password.open' | t -}}
    </button>
  </header>

  <main id="MainContent" tabindex="-1" class="flex flex-1 items-center bg-transparent py-12">
    <div class="page-width-narrow flex flex-col gap-6 {{ align_class }}">
      {%- if s.heading != blank -%}
        <h1 class="type-display">{{ s.heading | escape }}</h1>
      {%- else -%}
        <h1 class="type-display">{{ shop.name | escape }}</h1>
      {%- endif -%}
      {%- if message != blank -%}
        <div class="rte type-lg opacity-90">{{ message }}</div>
      {%- endif -%}

      {%- if s.show_newsletter -%}
        {%- form 'customer', id: 'PasswordNewsletter', class: 'flex w-full max-w-md flex-col gap-3' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page">
          {%- if form.posted_successfully? -%}
            {%- assign signup_success = 'templates.password.signup_success' | t -%}
            {% render 'form-alert', tone: 'success', message: signup_success, focus: true %}
          {%- else -%}
            {%- if s.newsletter_heading != blank -%}
              <p class="font-semibold">{{ s.newsletter_heading | escape }}</p>
            {%- endif -%}
            <div class="flex flex-col gap-2 md:flex-row">
              <label for="PasswordNewsletter-email" class="sr-only">{{ 'sections.newsletter.label' | t }}</label>
              <input
                type="email"
                id="PasswordNewsletter-email"
                name="contact[email]"
                required
                autocomplete="email"
                placeholder="{{ 'sections.newsletter.label' | t }}"
                value="{{ form.email }}"
                class="field h-12 min-w-0 flex-1 aria-invalid:border-error"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="PasswordNewsletter-error"
                {% endif %}
              >
              <button type="submit" class="btn btn-primary h-12">{{ 'sections.newsletter.submit' | t }}</button>
            </div>
            {%- if form.errors -%}
              <p id="PasswordNewsletter-error" class="type-sm text-error" role="alert">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            {%- if s.consent_text != blank -%}
              <div class="rte type-xs opacity-80">{{ s.consent_text }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </main>

  {%- if s.show_footer -%}
    <footer class="page-width flex flex-col items-center justify-between gap-2 bg-transparent py-5 type-xs opacity-80 md:flex-row">
      <p>{{ powered_by_link }}</p>
      <p>{{ 'templates.password.owner' | t }} <a href="/admin" class="underline">{{ 'templates.password.owner_login' | t }}</a></p>
    </footer>
  {%- endif -%}
</div>

<aw-modal id="PasswordDialog" {% if password_has_errors %}data-open-on-load{% endif %}>
  <dialog
    data-ref="dialog"
    class="m-auto w-[calc(100%-2rem)] max-w-md rounded-card p-0 backdrop:bg-overlay surface-{{ s.dialog_color_scheme }} max-md:mb-0 max-md:w-full max-md:max-w-none max-md:rounded-b-none"
    aria-labelledby="PasswordDialogHeading"
  >
    <div class="flex items-center justify-between gap-4 px-6 pt-4">
      <h2 id="PasswordDialogHeading" class="type-h5">{{ 'templates.password.dialog_title' | t }}</h2>
      <button type="button" class="-me-2 flex size-11 items-center justify-center" data-modal-close aria-label="{{ 'general.accessibility.close' | t }}">
        {%- render 'icon', name: 'close', class: 'size-6' -%}
      </button>
    </div>
    <div class="px-6 pt-2 pb-6">{{ password_form }}</div>
  </dialog>
</aw-modal>
<script src="{{ 'c-modal.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-main-password",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_password.settings.heading.label",
      "info": "t:sections.main_password.settings.heading.info",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.main_password.settings.text.label",
      "info": "t:sections.main_password.settings.text.info"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:shared.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:shared.align.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.main_password.settings.newsletter_header"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.settings.show_newsletter.label",
      "info": "t:sections.main_password.settings.show_newsletter.info",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.main_password.settings.newsletter_heading.label",
      "default": "Be the first to know when we open.",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "richtext",
      "id": "consent_text",
      "label": "t:sections.main_password.settings.consent_text.label",
      "info": "t:sections.main_password.settings.consent_text.info",
      "default": "<p>By signing up you agree to receive emails from us. You can unsubscribe at any time.</p>",
      "visible_if": "{{ section.settings.show_newsletter }}"
    },
    {
      "type": "header",
      "content": "t:sections.main_password.settings.background_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main_password.settings.image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "color_scheme",
      "id": "image_color_scheme",
      "label": "t:sections.main_password.settings.image_color_scheme.label",
      "info": "t:sections.hero.settings.text_surface.info",
      "default": "scheme-3",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "info": "t:sections.main_password.settings.color_scheme.info",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "dialog_color_scheme",
      "label": "t:sections.main_password.settings.dialog_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "t:sections.main_password.settings.show_footer.label",
      "default": true
    }
  ]
}
{% endschema %}
