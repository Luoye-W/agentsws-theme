{% comment %}
  @description "Page not found" page: optional "404" line, heading (heading or display size) and message (editable, with sensible defaults), an optional search box, buttons to the home page and the catalog (either one can be the main button), and optional popular links (from a menu) and popular collections.
  Use when: templates/404.json only.
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: ''
  if heading == blank
    assign heading = 'templates.404.title' | t
  endif
  assign menu = s.menu
  if s.heading_size == 'display'
    assign heading_class = 'type-display'
  else
    assign heading_class = 'type-h1'
  endif
  if s.primary_button == 'home'
    assign home_class = 'btn btn-primary'
    assign shop_class = 'btn btn-secondary'
  else
    assign home_class = 'btn btn-secondary'
    assign shop_class = 'btn btn-primary'
  endif
-%}
<div
  class="surface-{{ s.color_scheme }} pt-[calc(var(--section-pt)*0.75)] pb-[calc(var(--section-pb)*0.75)] md:pt-(--section-pt) md:pb-(--section-pb)"
  style="--section-pt: calc({{ s.padding_top }}px * var(--s-section-scale, 1)); --section-pb: calc({{ s.padding_bottom }}px * var(--s-section-scale, 1));"
>
  <div class="page-width-narrow flex flex-col items-center gap-6 text-center">
    {%- if s.show_code -%}
      <p class="type-eyebrow text-muted">404</p>
    {%- endif -%}
    <h1 class="{{ heading_class }}">{{ heading | escape }}</h1>
    {%- if s.text != blank -%}
      <div class="rte type-lg text-muted">{{ s.text }}</div>
    {%- else -%}
      <p class="type-lg text-muted">{{ 'templates.404.subtext' | t }}</p>
    {%- endif -%}

    {%- if s.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="flex w-full max-w-lg gap-2">
        <label for="NotFoundSearch-{{ section.id }}" class="sr-only">{{ 'templates.search.label' | t }}</label>
        <input
          type="search"
          id="NotFoundSearch-{{ section.id }}"
          name="q"
          class="field h-12 min-w-0 flex-1"
          placeholder="{{ 'templates.404.search_placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit" class="btn btn-primary h-12" aria-label="{{ 'templates.search.submit' | t }}">
          {%- render 'icon', name: 'search', class: 'size-5' -%}
        </button>
      </form>
    {%- endif -%}

    <div class="flex w-full flex-col gap-3 md:w-auto md:flex-row">
      <a href="{{ routes.root_url }}" class="{{ home_class }}">{{ 'templates.404.back_home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="{{ shop_class }}">{{ 'general.continue_shopping' | t }}</a>
    </div>

    {%- if menu.links.size > 0 -%}
      <nav class="mt-4 flex w-full flex-col items-center gap-3 border-t border-border pt-8" aria-labelledby="NotFoundLinks-{{ section.id }}">
        <h2 id="NotFoundLinks-{{ section.id }}" class="type-h6">{{ s.menu_heading | default: menu.title | escape }}</h2>
        <ul class="flex flex-wrap justify-center gap-2" role="list">
          {%- for link in menu.links -%}
            <li>
              <a href="{{ link.url }}" class="inline-flex min-h-10 items-center rounded-full border border-border px-4 type-sm no-underline hover:border-fg">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  {%- if s.collections.size > 0 -%}
    <div class="page-width mt-12 flex flex-col gap-6">
      <h2 class="type-h4 text-center">{{ 'templates.404.popular_collections' | t }}</h2>
      <ul class="grid grid-cols-2 grid-gap md:grid-cols-4" role="list">
        {%- for collection in s.collections limit: 8 -%}
          {%- assign collection_image = collection.featured_image -%}
          <li>
            <a href="{{ collection.url }}" class="group flex flex-col gap-3 no-underline">
              <div class="aspect-square overflow-hidden rounded-media bg-placeholder">
                {%- if collection_image -%}
                  {{
                    collection_image
                    | image_url: width: 800
                    | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: '', class: 'size-full object-cover transition-transform duration-500 group-hover:scale-105'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'size-full' }}
                {%- endif -%}
              </div>
              <span class="type-card group-hover:underline">{{ collection.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "enabled_on": { "templates": ["404"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_404.settings.heading.label",
      "info": "t:sections.main_404.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.main_404.settings.text.label",
      "info": "t:sections.main_404.settings.text.info"
    },
    {
      "type": "checkbox",
      "id": "show_code",
      "label": "t:sections.main_404.settings.show_code.label",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main_404.settings.heading_size.label",
      "options": [
        { "value": "h1", "label": "t:blocks.heading.settings.size.options.h1" },
        { "value": "display", "label": "t:blocks.heading.settings.size.options.display" }
      ],
      "default": "h1"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main_404.settings.show_search.label",
      "default": true
    },
    {
      "type": "select",
      "id": "primary_button",
      "label": "t:sections.main_404.settings.primary_button.label",
      "options": [
        { "value": "shop", "label": "t:sections.main_404.settings.primary_button.options.shop" },
        { "value": "home", "label": "t:sections.main_404.settings.primary_button.options.home" }
      ],
      "default": "shop"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.main_404.settings.menu.label",
      "info": "t:sections.main_404.settings.menu.info"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "t:sections.main_404.settings.menu_heading.label",
      "info": "t:sections.main_404.settings.menu_heading.info"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.main_404.settings.collections.label",
      "limit": 8
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
