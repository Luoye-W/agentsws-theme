{% comment %}
  @description Reset password (classic accounts, from the reset email): new password and confirmation with show / hide, errors next to the fields, and a link back to login.
  Use when: templates/customers/reset_password.json only.
{% endcomment %}
{%- assign s = section.settings -%}
<div
  class="surface-{{ s.color_scheme }} pt-[calc(var(--section-pt)*0.75)] pb-[calc(var(--section-pb)*0.75)] md:pt-(--section-pt) md:pb-(--section-pb)"
  style="--section-pt: calc({{ s.padding_top }}px * var(--s-section-scale, 1)); --section-pb: calc({{ s.padding_bottom }}px * var(--s-section-scale, 1));"
>
  <div class="page-width">
    <div class="mx-auto flex w-full max-w-md flex-col gap-6">
      <div class="flex flex-col gap-2 text-center">
        <h1 class="type-h1">{{ 'customer.reset.title' | t }}</h1>
        <p class="text-muted">{{ 'customer.reset.subtext' | t }}</p>
      </div>
      {%- form 'reset_customer_password', class: 'flex flex-col gap-4' -%}
        {%- if form.errors -%}
          {%- assign reset_errors = form.errors | default_errors -%}
          {% render 'form-alert', tone: 'error', message: reset_errors, focus: true %}
        {%- endif -%}
        {%- assign password_label = 'customer.fields.password_new' | t -%}
        {%- assign password_error = form.errors.messages.password -%}
        {% render 'account-field',
          type: 'password',
          name: 'customer[password]',
          id: 'ResetPassword',
          label: password_label,
          autocomplete: 'new-password',
          required: true,
          error: password_error
        %}
        {%- assign confirm_label = 'customer.fields.password_confirm' | t -%}
        {%- assign confirm_error = form.errors.messages.password_confirmation -%}
        {% render 'account-field',
          type: 'password',
          name: 'customer[password_confirmation]',
          id: 'ResetPasswordConfirm',
          label: confirm_label,
          autocomplete: 'new-password',
          required: true,
          error: confirm_error
        %}
        <button type="submit" class="btn btn-primary mt-2 w-full">{{ 'customer.reset.submit' | t }}</button>
      {%- endform -%}
      <a href="{{ routes.account_login_url }}" class="self-center type-sm underline">{{ 'customer.reset.back_to_login' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_reset_password.name",
  "tag": "section",
  "class": "section-main-reset-password",
  "enabled_on": {
    "templates": ["customers/reset_password"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
