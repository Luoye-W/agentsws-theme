{
  "sections": {
    "hero": {
      "type": "container",
      "blocks": {
        "hero-copy": {
          "type": "group",
          "settings": {
            "width": "half",
            "gap": 20
          },
          "blocks": {
            "eyebrow": {
              "type": "heading",
              "settings": {
                "text": "New season",
                "size": "eyebrow",
                "tag": "p"
              }
            },
            "title": {
              "type": "heading",
              "settings": {
                "text": "Built to be changed by AI agents",
                "size": "display",
                "tag": "h1"
              }
            },
            "intro": {
              "type": "text",
              "settings": {
                "text": "<p>Every section and block in this theme is documented for agents, so store operators can ask for changes in plain language.</p>",
                "size": "lg",
                "muted": true
              }
            },
            "cta": {
              "type": "button",
              "settings": {
                "label": "Shop all",
                "link": "shopify://collections/all"
              }
            }
          },
          "block_order": [
            "eyebrow",
            "title",
            "intro",
            "cta"
          ]
        },
        "hero-image": {
          "type": "image",
          "settings": {
            "aspect": "portrait"
          }
        }
      },
      "block_order": [
        "hero-copy",
        "hero-image"
      ],
      "settings": {
        "direction": "row",
        "align": "center",
        "gap": 48,
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "story": {
      "type": "container",
      "blocks": {
        "story-title": {
          "type": "heading",
          "settings": {
            "text": "Tell your story",
            "size": "h2",
            "alignment": "center"
          }
        },
        "story-text": {
          "type": "text",
          "settings": {
            "alignment": "center",
            "muted": true
          }
        }
      },
      "block_order": [
        "story-title",
        "story-text"
      ],
      "settings": {
        "align": "center",
        "width": "narrow",
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": [
    "hero",
    "story"
  ]
}
