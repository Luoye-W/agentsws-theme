{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "product-title",
          "settings": {
            "size": "h2"
          }
        },
        "rating": {
          "type": "product-rating",
          "settings": {
            "anchor": "reviews"
          }
        },
        "price": {
          "type": "product-price",
          "settings": {}
        },
        "badges": {
          "type": "product-badges",
          "settings": {
            "sale_style": "percent",
            "show_sold_out": true,
            "new_days": 0,
            "show_label": true
          }
        },
        "countdown": {
          "type": "product-countdown",
          "settings": {
            "heading": "Offer ends in",
            "metafield": "custom.sale_ends",
            "use_color_scheme": false,
            "color_scheme": "scheme-1"
          }
        },
        "highlights": {
          "type": "product-icon-list",
          "settings": {
            "heading": "",
            "source": "metafield",
            "metafield": "custom.highlights",
            "columns": "1",
            "icon_size": 20,
            "text_size": "sm"
          }
        },
        "picker": {
          "type": "product-variant-picker",
          "settings": {
            "style": "buttons",
            "swatches": true
          }
        },
        "inventory": {
          "type": "product-inventory",
          "settings": {
            "low_stock_threshold": 10,
            "show_bar": true,
            "show_count": "low",
            "show_incoming": true
          }
        },
        "buy": {
          "type": "product-buy-buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true
          }
        },
        "sku": {
          "type": "product-sku",
          "settings": {
            "show_label": true
          }
        },
        "addons": {
          "type": "product-addons",
          "settings": {
            "heading": "Frequently bought together",
            "include_current": true,
            "preselect": false
          }
        },
        "pickup": {
          "type": "product-pickup",
          "settings": {}
        },
        "trust": {
          "type": "product-trust",
          "settings": {
            "style": "card",
            "icon_size": 20,
            "text_size": "sm"
          },
          "blocks": {
            "shipping": {
              "type": "_product-icon-item",
              "settings": {
                "icon": "truck",
                "text": "Add your delivery promise"
              }
            },
            "returns": {
              "type": "_product-icon-item",
              "settings": {
                "icon": "return",
                "text": "Add your returns policy"
              }
            },
            "checkout": {
              "type": "_product-icon-item",
              "settings": {
                "icon": "lock",
                "text": "Secure checkout"
              }
            }
          },
          "block_order": [
            "shipping",
            "returns",
            "checkout"
          ]
        },
        "size-guide": {
          "type": "product-popup",
          "settings": {
            "label": "Size guide",
            "icon": "ruler",
            "style": "link"
          }
        },
        "complementary": {
          "type": "product-complementary",
          "settings": {
            "heading": "Pairs well with",
            "products_to_show": 3,
            "card_quick_add": true
          }
        },
        "details": {
          "type": "group",
          "settings": {
            "gap": 0,
            "align": "stretch"
          },
          "blocks": {
            "description-row": {
              "type": "collapsible",
              "settings": {
                "title": "Description",
                "open": true
              },
              "blocks": {
                "description": {
                  "type": "product-description",
                  "settings": {}
                }
              },
              "block_order": [
                "description"
              ]
            },
            "specs-row": {
              "type": "collapsible",
              "settings": {
                "title": "Specifications",
                "open": false
              },
              "blocks": {
                "specs": {
                  "type": "product-specs",
                  "settings": {
                    "namespace": "custom",
                    "key": "specifications"
                  }
                }
              },
              "block_order": [
                "specs"
              ]
            },
            "shipping-row": {
              "type": "collapsible",
              "settings": {
                "title": "Shipping & returns",
                "open": false
              },
              "blocks": {
                "shipping-text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Describe delivery times and your return policy here.</p>",
                    "size": "sm",
                    "muted": true
                  }
                }
              },
              "block_order": [
                "shipping-text"
              ]
            }
          },
          "block_order": [
            "description-row",
            "specs-row",
            "shipping-row"
          ]
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "badges",
        "countdown",
        "highlights",
        "picker",
        "inventory",
        "buy",
        "sku",
        "addons",
        "pickup",
        "trust",
        "size-guide",
        "complementary",
        "details"
      ],
      "settings": {
        "gallery_layout": "slider",
        "thumbnail_position": "below",
        "media_width": "large",
        "media_ratio": "square",
        "media_fit": "contain",
        "enable_zoom": true,
        "variant_media_only": false,
        "video_autoplay": false,
        "video_loop": false,
        "sticky_cart": "all",
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "padding_bottom": 80
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "card_quick_add": true
      }
    },
    "recently_viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4,
        "columns_desktop": 4,
        "mobile_layout": "slider",
        "card_quick_add": true,
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "main",
    "related",
    "recently_viewed"
  ]
}
