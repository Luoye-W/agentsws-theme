{% doc %}
  @description Heading and a vertical list of links from a store menu (Online Store → Navigation). Only the first level is shown. On phones the column can fold into an accordion under its heading (closed or open by default); from 750px up the list is always shown.
  Use when: footer link columns ("Shop", "Help"), sidebars, sitemap-style lists.

  @example
  {% content_for 'block', type: 'menu', id: 'footer-shop' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign accordion = false
  if s.mobile_accordion and s.heading != blank
    assign accordion = true
  endif
-%}
{%- capture links -%}
  <ul class="flex flex-col gap-2" role="list">
    {%- for link in s.menu.links -%}
      <li>
        <a href="{{ link.url }}" class="inline-flex min-h-6 items-center type-sm text-muted no-underline hover:text-fg hover:underline" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      </li>
    {%- endfor -%}
  </ul>
{%- endcapture -%}
<nav class="flex min-w-40 flex-col gap-3 max-md:w-full" aria-label="{{ s.heading | default: s.menu.title | escape }}" {{ block.shopify_attributes }}>
  {%- if accordion -%}
    <details class="group/menu border-b border-border md:hidden" {% if s.open_on_mobile %}open{% endif %}>
      <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between type-eyebrow [&::-webkit-details-marker]:hidden">
        {{- s.heading | escape -}}
        {%- render 'icon', name: 'chevron-down', class: 'size-4 transition group-open/menu:rotate-180' -%}
      </summary>
      <div class="pb-4">{{ links }}</div>
    </details>
    <div class="hidden flex-col gap-3 md:flex">
      <h2 class="type-eyebrow">{{ s.heading | escape }}</h2>
      {{ links }}
    </div>
  {%- else -%}
    {%- if s.heading != blank -%}
      <h2 class="type-eyebrow">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {{ links }}
  {%- endif -%}
</nav>

{% schema %}
{
  "name": "t:blocks.menu.name",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured_collection.settings.heading.label", "default": "Links" },
    { "type": "link_list", "id": "menu", "label": "t:sections.header.settings.menu.label", "default": "footer" },
    { "type": "checkbox", "id": "mobile_accordion", "label": "t:blocks.menu.settings.mobile_accordion.label", "info": "t:blocks.menu.settings.mobile_accordion.info", "default": true },
    { "type": "checkbox", "id": "open_on_mobile", "label": "t:blocks.menu.settings.open_on_mobile.label", "default": false, "visible_if": "{{ block.settings.mobile_accordion }}" }
  ],
  "presets": [{ "name": "t:blocks.menu.name" }]
}
{% endschema %}
