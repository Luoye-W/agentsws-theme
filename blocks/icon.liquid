{% doc %}
  @description One icon from the theme's built-in line-icon set (follows the text color) or an uploaded SVG/PNG, at a chosen size, optionally linked. A text label names the link (or the image) for screen readers; without a link and label the icon is decorative.
  Use when: a small visual cue next to text in any section that accepts theme blocks — trust badges in a group, an icon above a heading, a linked social or contact icon.

  @example
  {% content_for 'block', type: 'icon', id: 'icon' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign label = s.label | strip | escape

  case s.alignment
    when 'center'
      assign align_class = 'justify-center'
    when 'end'
      assign align_class = 'justify-end'
    else
      assign align_class = 'justify-start'
  endcase

  assign image_alt = ''
  if s.link == blank
    assign image_alt = label
  endif
-%}
{%- capture icon_html -%}
  {%- if s.custom_icon != blank -%}
    {{ s.custom_icon | image_url: width: 240 | image_tag: class: 'size-(--icon-block-size) object-contain', alt: image_alt, loading: 'lazy' }}
  {%- else -%}
    {%- render 'icon', name: s.icon, class: 'size-(--icon-block-size)' -%}
  {%- endif -%}
{%- endcapture -%}
{%- if s.custom_icon != blank or s.icon != 'none' -%}
  <div class="flex w-full {{ align_class }}" style="--icon-block-size: {{ s.size }}px;" {{ block.shopify_attributes }}>
    {%- if s.link != blank -%}
      <a
        href="{{ s.link }}"
        class="inline-flex rounded-btn text-fg hover:opacity-80"
        {% if label != blank %}
          aria-label="{{ label }}"
        {% endif %}
        {% if s.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- icon_html -}}
      </a>
    {%- else -%}
      <span class="inline-flex text-fg" {% if label != blank and s.custom_icon == blank %}role="img" aria-label="{{ label }}"{% endif %}>
        {{- icon_html -}}
      </span>
    {%- endif -%}
  </div>
{%- else -%}
  <div hidden {{ block.shopify_attributes }}></div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.icon.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.icon.settings.icon.label",
      "options": [
        { "value": "none", "label": "t:blocks.icon.settings.icon.options.none" },
        { "value": "check", "label": "t:blocks.feature.settings.icon.options.check" },
        { "value": "star", "label": "t:blocks.feature.settings.icon.options.star" },
        { "value": "sparkle", "label": "t:blocks.icon.settings.icon.options.sparkle" },
        { "value": "heart", "label": "t:blocks.icon.settings.icon.options.heart" },
        { "value": "award", "label": "t:blocks.icon.settings.icon.options.award" },
        { "value": "shield", "label": "t:blocks.feature.settings.icon.options.shield" },
        { "value": "lock", "label": "t:blocks.feature.settings.icon.options.lock" },
        { "value": "truck", "label": "t:blocks.feature.settings.icon.options.truck" },
        { "value": "package", "label": "t:blocks.icon.settings.icon.options.package" },
        { "value": "return", "label": "t:blocks.feature.settings.icon.options.return" },
        { "value": "gift", "label": "t:blocks.icon.settings.icon.options.gift" },
        { "value": "tag", "label": "t:blocks.icon.settings.icon.options.tag" },
        { "value": "credit-card", "label": "t:blocks.icon.settings.icon.options.credit_card" },
        { "value": "chat", "label": "t:blocks.feature.settings.icon.options.chat" },
        { "value": "mail", "label": "t:blocks.icon.settings.icon.options.mail" },
        { "value": "phone", "label": "t:blocks.icon.settings.icon.options.phone" },
        { "value": "users", "label": "t:blocks.icon.settings.icon.options.users" },
        { "value": "clock", "label": "t:blocks.icon.settings.icon.options.clock" },
        { "value": "calendar", "label": "t:blocks.icon.settings.icon.options.calendar" },
        { "value": "map-pin", "label": "t:blocks.icon.settings.icon.options.map_pin" },
        { "value": "globe", "label": "t:blocks.feature.settings.icon.options.globe" },
        { "value": "leaf", "label": "t:blocks.icon.settings.icon.options.leaf" },
        { "value": "water", "label": "t:blocks.feature.settings.icon.options.water" },
        { "value": "bolt", "label": "t:blocks.feature.settings.icon.options.bolt" },
        { "value": "battery", "label": "t:blocks.feature.settings.icon.options.battery" },
        { "value": "bluetooth", "label": "t:blocks.feature.settings.icon.options.bluetooth" },
        { "value": "headphones", "label": "t:blocks.feature.settings.icon.options.headphones" },
        { "value": "speaker", "label": "t:blocks.feature.settings.icon.options.speaker" },
        { "value": "ruler", "label": "t:blocks.icon.settings.icon.options.ruler" },
        { "value": "quote", "label": "t:blocks.icon.settings.icon.options.quote" }
      ],
      "default": "check"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:blocks.feature.settings.custom_icon.label",
      "info": "t:blocks.feature.settings.custom_icon.info"
    },
    {
      "type": "range",
      "id": "size",
      "label": "t:blocks.icon.settings.size.label",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.icon.settings.alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.align.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.align.options.center"
        },
        {
          "value": "end",
          "label": "t:shared.align.options.end"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.icon.settings.label.label",
      "info": "t:blocks.icon.settings.label.info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:blocks.button.settings.open_in_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.icon.name"
    }
  ]
}
{% endschema %}
