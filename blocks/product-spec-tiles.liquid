{% doc %}
  @description Spec highlight tiles: small tiles of icon + value + label ("40mm / Driver size", "38h / Battery life"), optionally inside a card with a heading ("Product highlights"). Rows come from child tiles or, per product, from a metafield — a list of single line texts or a multi-line text, one tile per line written "value|label|icon", e.g. "38h|Battery life|battery" (icon optional: battery, bluetooth, bolt, headphones, speaker, mic, waves, weight, plug, ruler, clock, water, shield, leaf, star, box, globe, check). Tile style bordered, filled or plain; columns fit the content or form an even grid. On the main product page the block can sit below the images on desktop (Placement). Hidden when empty.
  Use when: key numbers of a technical product (driver size, weight, battery, connectivity) under the gallery or in the info column; product-specific values maintained in admin (metafield mode).

  @example
  {% content_for 'block', type: 'product-spec-tiles', id: 'spec-tiles' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign product = closest.product
  assign known_icons = 'battery,bluetooth,bolt,headphones,speaker,mic,waves,weight,plug,ruler,clock,water,shield,leaf,star,box,globe,check,package,sparkle,award,lock,truck,return,gift,info' | split: ','

  comment
    Placement below the images only applies to top-level blocks of the section (main product splits on these markers).
  endcomment
  assign below = false
  if s.placement == 'below_media'
    for top_block in section.blocks
      if top_block.id == block.id
        assign below = true
        break
      endif
    endfor
  endif

  case s.columns
    when '2'
      assign list_class = 'grid grid-cols-2 gap-2'
    when '3'
      assign list_class = 'grid grid-cols-2 gap-2 md:grid-cols-3'
    when '4'
      assign list_class = 'grid grid-cols-2 gap-2 md:grid-cols-4'
    else
      assign list_class = 'flex flex-wrap gap-2'
  endcase

  comment
    Same classes as the child tile (_spec-tile): the style follows data-tile-style on the wrapper.
  endcomment
  assign tile_class = 'flex items-center gap-3 rounded-card border border-border px-4 py-3 in-data-[tile-style=filled]:border-transparent in-data-[tile-style=filled]:bg-fg/5 in-data-[tile-style=plain]:border-transparent in-data-[tile-style=plain]:ps-0'

  assign items = nil
  if s.source == 'metafield'
    assign field_path = s.metafield | default: 'custom.spec_tiles' | strip
    assign namespace = field_path | split: '.' | first
    assign key = field_path | split: '.' | last
    assign field = product.metafields[namespace][key]
    if field.type contains 'list'
      assign items = field.value
    elsif field.value != blank
      assign items = field.value | newline_to_br | split: '<br />'
    endif
  endif
-%}
{%- capture tiles_html -%}
  {%- if s.source == 'metafield' -%}
    {%- for item in items limit: 12 -%}
      {%- liquid
        assign line = item | strip
        if line == blank
          continue
        endif
        assign parts = line | split: '|'
        assign tile_value = parts[0] | strip
        assign tile_label = parts[1] | strip
        assign tile_icon = parts[2] | strip | downcase
        unless known_icons contains tile_icon
          assign tile_icon = ''
        endunless
      -%}
      <li class="{{ tile_class }}">
        {%- if tile_icon != blank -%}
          {%- render 'icon', name: tile_icon, class: 'size-(--tile-icon) text-muted' -%}
        {%- endif -%}
        <span class="flex min-w-0 flex-col">
          <span class="type-sm font-semibold">{{ tile_value | escape }}</span>
          {%- if tile_label != blank -%}
            <span class="type-xs text-muted">{{ tile_label | escape }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  {%- else -%}
    {% content_for 'blocks' %}
  {%- endif -%}
{%- endcapture -%}
{%- if tiles_html != blank -%}
  {%- if below -%}<!--aw:below-media-->{%- endif -%}
  <div
    class="flex flex-col gap-4{% if s.card %} rounded-card border border-border p-4 md:p-6{% endif %}"
    style="--tile-icon: {{ s.icon_size }}px;"
    data-tile-style="{{ s.tile_style }}"
    {{ block.shopify_attributes }}
  >
    {%- if s.heading != blank -%}
      <h2 class="type-h6">{{ s.heading | escape }}</h2>
    {%- endif -%}
    <ul class="{{ list_class }}" role="list">
      {{ tiles_html }}
    </ul>
  </div>
  {%- if below -%}<!--/aw:below-media-->{%- endif -%}
{%- elsif request.design_mode -%}
  <p class="type-xs text-muted" {{ block.shopify_attributes }}>{{ 'blocks.product_spec_tiles.empty' | t: field: field_path }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_spec_tiles.name",
  "tag": null,
  "blocks": [{ "type": "_spec-tile" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.product_spec_tiles.settings.heading.label"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:blocks.product_icon_list.settings.source.label",
      "options": [
        { "value": "blocks", "label": "t:blocks.product_spec_tiles.settings.source.options.blocks" },
        { "value": "metafield", "label": "t:blocks.product_icon_list.settings.source.options.metafield" }
      ],
      "default": "blocks"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "t:blocks.product_icon_list.settings.metafield.label",
      "info": "t:blocks.product_spec_tiles.settings.metafield.info",
      "default": "custom.spec_tiles",
      "visible_if": "{{ block.settings.source == 'metafield' }}"
    },
    {
      "type": "select",
      "id": "placement",
      "label": "t:blocks.product_spec_tiles.settings.placement.label",
      "info": "t:blocks.product_spec_tiles.settings.placement.info",
      "options": [
        { "value": "info", "label": "t:blocks.product_spec_tiles.settings.placement.options.info" },
        { "value": "below_media", "label": "t:blocks.product_spec_tiles.settings.placement.options.below_media" }
      ],
      "default": "info"
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "t:blocks.product_spec_tiles.settings.card.label",
      "default": false
    },
    {
      "type": "select",
      "id": "tile_style",
      "label": "t:blocks.product_spec_tiles.settings.tile_style.label",
      "options": [
        { "value": "bordered", "label": "t:blocks.product_spec_tiles.settings.tile_style.options.bordered" },
        { "value": "filled", "label": "t:blocks.product_spec_tiles.settings.tile_style.options.filled" },
        { "value": "plain", "label": "t:blocks.product_spec_tiles.settings.tile_style.options.plain" }
      ],
      "default": "bordered"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:blocks.product_spec_tiles.settings.columns.label",
      "options": [
        { "value": "auto", "label": "t:blocks.product_spec_tiles.settings.columns.options.auto" },
        { "value": "2", "label": "t:blocks.product_spec_tiles.settings.columns.options.two" },
        { "value": "3", "label": "t:blocks.product_spec_tiles.settings.columns.options.three" },
        { "value": "4", "label": "t:blocks.product_spec_tiles.settings.columns.options.four" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:blocks.product_icon_list.settings.icon_size.label",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_spec_tiles.name",
      "settings": { "heading": "Product highlights" },
      "blocks": {
        "tile-1": { "type": "_spec-tile", "settings": { "icon": "battery", "value": "Value", "label": "Add a key number" } },
        "tile-2": { "type": "_spec-tile", "settings": { "icon": "weight", "value": "Value", "label": "Add a key number" } },
        "tile-3": { "type": "_spec-tile", "settings": { "icon": "bluetooth", "value": "Value", "label": "Add a key number" } }
      },
      "block_order": ["tile-1", "tile-2", "tile-3"]
    }
  ]
}
{% endschema %}
