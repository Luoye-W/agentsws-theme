{% doc %}
  @description Nested layout box that holds other blocks in a row or column, with its own optional color scheme, padding and optional card styling. Groups can contain groups.
  Use when: arranging existing blocks side by side inside a section (e.g. image next to heading + text + button), simple cards or columns. Repeating items with their own icon/text settings that operators edit often (badges, feature lists) are better as a custom block with child blocks.

  @example
  {% content_for 'block', type: 'group', id: 'column' %}
{% enddoc %}
{%- liquid
  assign s = block.settings

  assign surface_class = ''
  if s.use_color_scheme
    assign surface_class = 'surface-' | append: s.color_scheme
  endif

  assign card_class = ''
  if s.card
    assign card_class = 'rounded-card border border-border overflow-hidden'
  endif

  comment
    Fractions share the row by flex ratio (the gap is subtracted automatically), capped at the fraction when alone.
    Fixed percentages (w-1/2) plus a gap overflow the row and wrap.
  endcomment
  case s.width
    when 'half'
      assign width_class = 'w-full min-w-0 md:w-auto md:flex-[1_1_0%] md:max-w-1/2'
    when 'third'
      assign width_class = 'w-full min-w-0 md:w-auto md:flex-[1_1_0%] md:max-w-1/3'
    when 'two_thirds'
      assign width_class = 'w-full min-w-0 md:w-auto md:flex-[2_1_0%] md:max-w-2/3'
    when 'auto'
      assign width_class = 'w-auto'
    else
      assign width_class = 'w-full'
  endcase
-%}
<div
  class="{% render 'flex-layout-classes', direction: s.direction, align: s.align, justify: s.justify, wrap: s.wrap, stack_on_mobile: s.stack_on_mobile %} gap-(--group-gap) p-(--group-padding) {{ width_class }} {{ surface_class }} {{ card_class }}"
  style="--group-gap: {{ s.gap }}px; --group-padding: {{ s.padding }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "t:blocks.group.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:shared.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:shared.direction.options.column"
        },
        {
          "value": "row",
          "label": "t:shared.direction.options.row"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "t:shared.wrap",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:shared.stack_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:shared.align.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.align.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.align.options.center"
        },
        {
          "value": "end",
          "label": "t:shared.align.options.end"
        },
        {
          "value": "stretch",
          "label": "t:shared.align.options.stretch"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "justify",
      "label": "t:shared.justify.label",
      "options": [
        {
          "value": "start",
          "label": "t:shared.justify.options.start"
        },
        {
          "value": "center",
          "label": "t:shared.justify.options.center"
        },
        {
          "value": "end",
          "label": "t:shared.justify.options.end"
        },
        {
          "value": "between",
          "label": "t:shared.justify.options.between"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:shared.gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.settings.width.label",
      "options": [
        {
          "value": "full",
          "label": "t:blocks.group.settings.width.options.full"
        },
        {
          "value": "half",
          "label": "t:blocks.group.settings.width.options.half"
        },
        {
          "value": "third",
          "label": "t:blocks.group.settings.width.options.third"
        },
        {
          "value": "two_thirds",
          "label": "t:blocks.group.settings.width.options.two_thirds"
        },
        {
          "value": "auto",
          "label": "t:blocks.group.settings.width.options.auto"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:shared.use_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.use_color_scheme }}"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:blocks.group.settings.padding.label",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "t:blocks.group.settings.card.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.name",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "size": "h4",
            "tag": "h3"
          }
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
