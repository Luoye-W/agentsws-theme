{% doc %}
  @description One message in the announcement bar: short text (bold/italic/links allowed), optional shorter text for phones, optional link for the whole message and an optional icon from the theme icon set.
  Use when: only inside the announcement-bar section.

  @example
  {% content_for 'blocks' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign has_mobile_text = false
  if s.text_mobile != blank
    assign has_mobile_text = true
  endif
-%}
<div
  class="announcement-item flex min-w-0 items-center justify-center gap-2 text-center font-semibold tracking-wide uppercase in-data-[mode=marquee]:whitespace-nowrap"
  data-ref="slide"
  {{ block.shopify_attributes }}
>
  {%- if s.icon != 'none' -%}
    {%- render 'icon', name: s.icon, class: 'size-4 max-md:hidden' -%}
  {%- endif -%}
  {%- capture message -%}
    {%- if has_mobile_text -%}
      <span class="md:hidden">{{ s.text_mobile }}</span>
      <span class="max-md:hidden">{{ s.text }}</span>
    {%- else -%}
      {{ s.text }}
    {%- endif -%}
  {%- endcapture -%}
  {%- if s.link != blank -%}
    <a href="{{ s.link }}" class="inline-flex min-h-8 items-center gap-1.5 no-underline hover:underline">
      {{- message -}}
      {%- render 'icon', name: 'arrow-right', class: 'size-3.5 rtl:rotate-180' -%}
    </a>
  {%- else -%}
    <p>{{ message }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.announcement.name",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.announcement_bar.settings.text.label",
      "default": "Add a store-wide message"
    },
    {
      "type": "inline_richtext",
      "id": "text_mobile",
      "label": "t:blocks.announcement.settings.text_mobile.label",
      "info": "t:blocks.announcement.settings.text_mobile.info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:shared.icon_choice.label",
      "info": "t:blocks.announcement.settings.icon.info",
      "options": [
        { "value": "none", "label": "t:shared.icon_choice.options.none" },
        { "value": "truck", "label": "t:shared.icon_choice.options.truck" },
        { "value": "return", "label": "t:shared.icon_choice.options.return" },
        { "value": "box", "label": "t:shared.icon_choice.options.box" },
        { "value": "gift", "label": "t:shared.icon_choice.options.gift" },
        { "value": "tag", "label": "t:shared.icon_choice.options.tag" },
        { "value": "clock", "label": "t:shared.icon_choice.options.clock" },
        { "value": "lock", "label": "t:shared.icon_choice.options.lock" },
        { "value": "shield", "label": "t:shared.icon_choice.options.shield" },
        { "value": "star", "label": "t:shared.icon_choice.options.star" },
        { "value": "heart", "label": "t:shared.icon_choice.options.heart" },
        { "value": "chat", "label": "t:shared.icon_choice.options.chat" },
        { "value": "mail", "label": "t:shared.icon_choice.options.mail" },
        { "value": "phone", "label": "t:shared.icon_choice.options.phone" },
        { "value": "globe", "label": "t:shared.icon_choice.options.globe" },
        { "value": "map-pin", "label": "t:shared.icon_choice.options.map_pin" },
        { "value": "bolt", "label": "t:shared.icon_choice.options.bolt" },
        { "value": "check", "label": "t:shared.icon_choice.options.check" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.announcement.name"
    }
  ]
}
{% endschema %}
