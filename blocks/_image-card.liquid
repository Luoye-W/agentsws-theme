{% doc %}
  @description One card in an Image cards section: image with title, optional text and link label over a dark gradient at the bottom. The whole card is the link.
  Use when: only inside the "image-cards" section.

  @example
  {% content_for 'block', type: '_image-card', id: 'card-1' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign link = s.link | default: s.collection.url
  assign title = s.title | escape
  if title == blank
    assign title = s.collection.title | escape
  endif
  assign image = s.image | default: s.collection.featured_image
  comment
    The card title is the link text, so the image is decorative unless the merchant wrote alt text.
  endcomment
  assign image_alt = s.image.alt | escape | default: ''
-%}
<li
  class="group relative isolate shrink-0 overflow-hidden rounded-media bg-fg/5 in-data-[mobile-layout=slider]:w-[78%] md:in-data-[mobile-layout=slider]:w-auto in-data-[mobile-layout=slider]:snap-start aspect-(--card-ratio)"
  {{ block.shopify_attributes }}
>
  {%- if image -%}
    {{
      image
      | image_url: width: 1600
      | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 80vw', class: 'absolute inset-0 -z-10 size-full object-cover transition duration-500 group-hover:scale-[1.03]', alt: image_alt, loading: 'lazy'
    }}
  {%- else -%}
    {{ 'collection-1' | placeholder_svg_tag: 'absolute inset-0 -z-10 size-full' }}
  {%- endif -%}
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-[rgb(0_0_0/var(--card-overlay))] via-[rgb(0_0_0/calc(var(--card-overlay)*0.4))] to-transparent" aria-hidden="true"></div>
  <div class="surface-{{ section.settings.text_color_scheme }} flex h-full flex-col justify-end gap-2 bg-transparent p-5 md:p-7">
    <h3 class="type-h3">
      {%- if link != blank -%}
        <a href="{{ link }}" class="no-underline after:absolute after:inset-0 focus-visible:outline-none after:focus-visible:outline-2 after:focus-visible:-outline-offset-4">{{ title }}</a>
      {%- else -%}
        {{ title }}
      {%- endif -%}
    </h3>
    {%- if s.text != blank -%}<p class="type-sm opacity-80">{{ s.text | escape }}</p>{%- endif -%}
    {%- if s.link_label != blank -%}
      <span class="inline-flex items-center gap-2 pt-1 font-semibold" aria-hidden="true">
        {{- s.link_label | escape -}}
        {%- render 'icon', name: 'arrow-right', class: 'size-4 transition group-hover:translate-x-1 rtl:rotate-180' -%}
      </span>
    {%- endif -%}
  </div>
</li>

{% schema %}
{
  "name": "t:blocks.image_card.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label",
      "info": "t:blocks.image_card.settings.image.info"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:blocks.image_card.settings.title.label",
      "info": "t:blocks.image_card.settings.title.info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.featured_collection.settings.text.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label",
      "info": "t:blocks.image_card.settings.link.info"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.image_card.settings.link_label.label",
      "default": "Shop now"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.image_card.name"
    }
  ]
}
{% endschema %}
