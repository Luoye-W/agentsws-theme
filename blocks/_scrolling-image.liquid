{% doc %}
  @description One tile in a Scrolling images row: an image (separate mobile image optional) with an optional caption, or — when no image is chosen — a large text tile. Optional link; the tile's accessible name is its caption, the image alt text or the link label.
  Use when: only inside the "scrolling-images" section.

  @example
  {% content_for 'block', type: '_scrolling-image', id: 'tile-1' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign image = s.image
  assign mobile_image = s.image_mobile | default: s.image
  assign caption = s.text | escape
  assign image_alt = image.alt | escape
  if caption != blank
    assign image_alt = ''
  endif
  assign ratio = image.aspect_ratio | default: 1
  assign ratio_mobile = mobile_image.aspect_ratio | default: ratio
  assign link_label = s.link_label | escape
-%}
<li
  class="shrink-0"
  style="--tile-ratio: {{ ratio }}; --tile-ratio-mobile: {{ ratio_mobile }};"
  {{ block.shopify_attributes }}
>
  {%- capture tile -%}
    {%- if image != blank -%}
      <span class="relative block h-(--tile-h-mobile) aspect-(--tile-ratio-mobile) overflow-hidden rounded-media bg-placeholder md:h-(--tile-h) md:aspect-(--tile-ratio)">
        <picture>
          {%- if s.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_image | image_url: width: 300 }} 300w, {{ mobile_image | image_url: width: 500 }} 500w, {{ mobile_image | image_url: width: 800 }} 800w"
              sizes="40vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {%- endif -%}
          {{ image | image_url: width: 1200 | image_tag: widths: '300, 500, 800, 1200', sizes: '(min-width: 750px) 30vw, 50vw', loading: 'lazy', alt: image_alt, class: 'size-full object-cover', draggable: 'false' }}
        </picture>
      </span>
      {%- if caption != blank -%}
        <span class="type-sm mt-2 block text-muted">{{ caption }}</span>
      {%- endif -%}
    {%- elsif caption != blank -%}
      <span class="type-h2 flex h-(--tile-h-mobile) items-center whitespace-nowrap md:h-(--tile-h)">{{ caption }}</span>
    {%- else -%}
      <span class="block h-(--tile-h-mobile) aspect-[4/5] overflow-hidden rounded-media bg-placeholder md:h-(--tile-h)">
        {{ 'image' | placeholder_svg_tag: 'size-full' }}
      </span>
    {%- endif -%}
  {%- endcapture -%}

  {%- if s.link != blank -%}
    <a
      href="{{ s.link }}"
      class="block no-underline"
      {% if link_label != blank %}
        aria-label="{{ link_label }}"
      {% endif %}
    >
      {{- tile -}}
    </a>
  {%- else -%}
    <div>{{- tile -}}</div>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "t:blocks.scrolling_image.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero.settings.image_mobile.label",
      "info": "t:blocks.scrolling_image.settings.image_mobile.info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.scrolling_image.settings.text.label",
      "info": "t:blocks.scrolling_image.settings.text.info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.collage_item.settings.link_label.label",
      "info": "t:blocks.collage_item.settings.link_label.info",
      "visible_if": "{{ block.settings.link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.scrolling_image.name"
    }
  ]
}
{% endschema %}
