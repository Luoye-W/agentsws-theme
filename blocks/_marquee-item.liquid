{% doc %}
  @description One phrase in a Marquee section, optionally a link, followed by the section's separator (dot, slash, star or none). No separator is added when the phrase already ends with one of its own (/ | • · * ✦ — -), so a strip never shows two in a row. Outline text follows the section setting.
  Use when: only inside the "marquee" section.

  @example
  {% content_for 'block', type: '_marquee-item', id: 'phrase-1' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign text = s.text | strip
  assign last_char = text | slice: -1, 1
  assign separator = section.settings.separator
  assign own_separators = '/,|,•,·,*,✦,—,-,–' | split: ','
  if own_separators contains last_char
    assign separator = 'none'
  endif
-%}
{%- if text == blank -%}
  <span hidden {{ block.shopify_attributes }}></span>
{%- else -%}
  <span class="inline-flex items-center gap-x-(--marquee-gap)" {{ block.shopify_attributes }}>
    {%- if s.link != blank -%}
      <a href="{{ s.link }}" class="no-underline hover:underline in-data-[outline=true]:[-webkit-text-stroke:1px_var(--c-fg)] in-data-[outline=true]:text-transparent">{{ text | escape }}</a>
    {%- else -%}
      <span class="in-data-[outline=true]:[-webkit-text-stroke:1px_var(--c-fg)] in-data-[outline=true]:text-transparent">{{ text | escape }}</span>
    {%- endif -%}
    {%- case separator -%}
      {%- when 'dot' -%}
        <span class="inline-block size-[0.35em] shrink-0 rounded-full bg-fg" aria-hidden="true"></span>
      {%- when 'slash' -%}
        <span class="shrink-0 text-muted" aria-hidden="true">/</span>
      {%- when 'star' -%}
        <span class="inline-flex shrink-0" aria-hidden="true">{%- render 'icon', name: 'sparkle', class: 'size-[0.8em]' -%}</span>
    {%- endcase -%}
  </span>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.marquee_item.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.marquee_item.settings.text.label",
      "default": "Add a short phrase"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.marquee_item.name"
    }
  ]
}
{% endschema %}
