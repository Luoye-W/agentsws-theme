{% doc %}
  @description Share row: "Share:" followed by round icon links for the networks switched on in Theme settings → Social media → Share buttons (Facebook, X, Pinterest, WhatsApp, Telegram, email) plus "Copy link" (confirmed with a status message) and, where the device supports it, a native "Share" button. Links open in a new tab and say so to screen readers. At the other end of the row an optional "Need help?" link to a page, and/or Pop-up link child blocks that open a store page in a side panel (size guide, help, shipping).
  Use when: bottom of the product info column (or article pages) — a compact share + help line instead of the Share dropdown button.

  @example
  {% content_for 'block', type: 'product-share', id: 'share-row' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign share_url = request.origin | append: request.path
  assign share_title = page_title | default: shop.name
  assign share_image = page_image
  if closest.product
    assign share_title = closest.product.title
    assign share_image = closest.product.featured_image
  elsif article
    assign share_title = article.title
    assign share_image = article.image
  endif
  assign encoded_url = share_url | url_encode
  assign encoded_title = share_title | url_encode
  assign title_and_url = share_title | append: ' ' | append: share_url | url_encode
  assign new_window = 'general.accessibility.new_window' | t
  assign link_class = 'flex size-10 items-center justify-center rounded-full hover:bg-fg/5'
-%}
<aw-share-row
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
  data-url="{{ share_url | escape }}"
  data-title="{{ share_title | escape }}"
  data-copied="{{ 'blocks.share.copied' | t | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="flex flex-wrap items-center gap-1">
    {%- if s.label != blank -%}
      <p class="me-2 type-sm">{{ s.label | escape }}</p>
    {%- endif -%}
    <ul class="flex flex-wrap items-center" role="list">
      {%- if settings.share_facebook -%}
        <li>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}" target="_blank" rel="noopener" class="{{ link_class }}">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3.5h-2.2A3.8 3.8 0 0 0 9 7.3v13.2M6.5 11H14"/></svg>
            <span class="sr-only">Facebook {{ new_window }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.share_x -%}
        <li>
          <a href="https://x.com/intent/post?url={{ encoded_url }}&amp;text={{ encoded_title }}" target="_blank" rel="noopener" class="{{ link_class }}">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4h4.3l11.7 16h-4.3z"/><path d="M19.5 4l-6.4 7M4.5 20l6.4-7"/></svg>
            <span class="sr-only">X {{ new_window }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.share_pinterest -%}
        {%- liquid
          assign pin_media = ''
          if share_image
            assign pin_media = share_image | image_url: width: 1200 | prepend: 'https:' | url_encode
          endif
        -%}
        <li>
          <a href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&amp;description={{ encoded_title }}{% if pin_media != blank %}&amp;media={{ pin_media }}{% endif %}" target="_blank" rel="noopener" class="{{ link_class }}">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M11.2 11l-2 9"/><path d="M9.6 14.2c-1.4-3.6.8-6.7 3.5-6.7 2.4 0 3.9 1.8 3.4 4.3-.4 2.2-1.9 3.6-3.9 3.2"/></svg>
            <span class="sr-only">Pinterest {{ new_window }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.share_whatsapp -%}
        <li>
          <a href="https://wa.me/?text={{ title_and_url }}" target="_blank" rel="noopener" class="{{ link_class }}">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20l1.2-3.9A8.5 8.5 0 1 1 8.1 19z"/><path d="M9 8.5c0 3.4 3 6.4 6.5 6.5l1-1.6-2-1-1 .9c-1.2-.5-2.4-1.7-2.9-2.9l.9-1-1-2z"/></svg>
            <span class="sr-only">WhatsApp {{ new_window }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.share_telegram -%}
        <li>
          <a href="https://t.me/share/url?url={{ encoded_url }}&amp;text={{ encoded_title }}" target="_blank" rel="noopener" class="{{ link_class }}">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 4.5L3.5 11l6 2.5 2.5 6.5 3-4.5 4.5 3.5z"/><path d="M9.5 13.5l6-4.5"/></svg>
            <span class="sr-only">Telegram {{ new_window }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if settings.share_email -%}
        <li>
          <a href="mailto:?subject={{ encoded_title }}&amp;body={{ encoded_url }}" class="{{ link_class }}">
            {%- render 'icon', name: 'mail', class: 'size-5' -%}
            <span class="sr-only">{{ 'blocks.share.email' | t }}</span>
          </a>
        </li>
      {%- endif -%}
      {%- if s.show_copy -%}
        <li>
          <button type="button" class="{{ link_class }}" data-ref="copy" hidden>
            {%- render 'icon', name: 'link', class: 'size-5' -%}
            <span class="sr-only">{{ 'blocks.share.copy_link' | t }}</span>
          </button>
        </li>
      {%- endif -%}
      {%- if s.native_share -%}
        <li>
          <button type="button" class="{{ link_class }}" data-ref="native" hidden>
            {%- render 'icon', name: 'share', class: 'size-5' -%}
            <span class="sr-only">{{ 'blocks.product_share.more' | t }}</span>
          </button>
        </li>
      {%- endif -%}
    </ul>
    <p class="ms-2 type-xs text-success empty:hidden" role="status" data-ref="status"></p>
  </div>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    {%- if s.help_label != blank and s.help_link != blank -%}
      <a href="{{ s.help_link }}" class="inline-flex items-center gap-2 type-sm underline underline-offset-4">
        {%- render 'icon', name: 'help', class: 'size-5' -%}
        {{- s.help_label | escape -}}
      </a>
    {%- endif -%}
    {% content_for 'blocks' %}
  </div>
</aw-share-row>
<script src="{{ 'c-share-row.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:blocks.product_share.name",
  "tag": null,
  "blocks": [{ "type": "product-popup" }],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.share.settings.hint"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.share.settings.label.label",
      "default": "Share:"
    },
    {
      "type": "checkbox",
      "id": "show_copy",
      "label": "t:blocks.product_share.settings.show_copy.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "native_share",
      "label": "t:blocks.product_share.settings.native_share.label",
      "info": "t:blocks.product_share.settings.native_share.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.product_share.settings.help_header"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.product_share.settings.help_info"
    },
    {
      "type": "text",
      "id": "help_label",
      "label": "t:blocks.product_share.settings.help_label.label",
      "default": "Need help?"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "t:blocks.product_share.settings.help_link.label",
      "visible_if": "{{ block.settings.help_label != blank }}"
    }
  ],
  "presets": [{ "name": "t:blocks.product_share.name" }]
}
{% endschema %}
