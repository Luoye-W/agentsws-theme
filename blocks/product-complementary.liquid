{% doc %}
  @description "Pairs well with" list: Shopify's complementary product recommendations for this product as compact rows (image, title, price) with a quick add button — single-variant products are added at once, others open the quick view. Loads after the page when scrolled near; stays hidden when Shopify has no complementary products.
  Use when: product info column, to suggest accessories or add-ons. Set the pairs in the Shopify Search & Discovery app → Product recommendations → Complementary products.

  @example
  {% content_for 'block', type: 'product-complementary', id: 'complementary' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign product = closest.product
-%}
{%- if product -%}
  <aw-recommendations
    class="flex flex-col gap-3"
    data-url="{{ routes.product_recommendations_url }}?section_id=complementary-products&product_id={{ product.id }}&limit={{ s.products_to_show }}&intent=complementary"
    {% unless s.card_quick_add %}
      data-strip-quick-add
    {% endunless %}
    {% unless request.design_mode %}
      hidden
    {% endunless %}
    {{ block.shopify_attributes }}
  >
    {%- if s.heading != blank -%}
      <h2 class="type-h6">{{ s.heading | escape }}</h2>
    {%- endif -%}
    <div data-ref="results" aria-live="polite">
      {%- if request.design_mode -%}
        <p class="type-xs text-muted">{{ 'blocks.product_complementary.editor_hint' | t }}</p>
      {%- endif -%}
    </div>
  </aw-recommendations>
  <script src="{{ 'c-recommendations.js' | asset_url }}" type="module"></script>
  {%- if s.card_quick_add -%}
    <script src="{{ 'c-quick-add.js' | asset_url }}" type="module"></script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_complementary.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.product_complementary.settings.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.product_complementary.settings.heading.label",
      "default": "Pairs well with"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "card_quick_add",
      "label": "t:shared.card_quick_add.label",
      "info": "t:shared.card_quick_add.info",
      "default": true
    }
  ],
  "presets": [{ "name": "t:blocks.product_complementary.name" }]
}
{% endschema %}
