{% doc %}
  @description One entry in the mobile dock: icon above a short label. Actions: home, menu (opens the header menu drawer; hidden when the header has no menu), search (opens the search drawer, or the search page), cart (live item count; opens the cart drawer, or the cart page), account (only when customer accounts are on) or a custom link with an icon of your choice. Without JavaScript every entry is a normal link.
  Use when: only inside the mobile-dock section.

  @example
  {% content_for 'blocks' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign show = true
  assign current = false
  assign drawer = ''
  assign url = ''
  assign icon_name = s.icon

  case s.action
    when 'home'
      assign url = routes.root_url
      assign icon_name = 'home'
      if template.name == 'index'
        assign current = true
      endif
    when 'menu'
      assign drawer = 'MenuDrawer'
      assign icon_name = 'menu'
    when 'search'
      assign url = routes.search_url
      assign icon_name = 'search'
      if settings.search_type == 'drawer'
        assign drawer = 'SearchDrawer'
      endif
      if template.name == 'search'
        assign current = true
      endif
    when 'cart'
      assign url = routes.cart_url
      if settings.cart_icon == 'cart'
        assign icon_name = 'trolley'
      else
        assign icon_name = 'bag'
      endif
      if settings.cart_type == 'drawer' and template.name != 'cart'
        assign drawer = 'CartDrawer'
      endif
      if template.name == 'cart'
        assign current = true
      endif
    when 'account'
      assign url = routes.account_url
      assign icon_name = 'account'
      unless shop.customer_accounts_enabled
        assign show = false
      endunless
      if request.path contains '/account'
        assign current = true
      endif
    else
      assign url = s.link | default: routes.root_url
      if s.link != blank and request.path == s.link
        assign current = true
      endif
  endcase

  assign item_class = 'relative flex h-full w-full flex-col items-center justify-center gap-0.5 type-xs no-underline aria-[current=page]:font-semibold'
-%}
{%- if show -%}
  <li
    class="min-w-0 {% if s.action == 'menu' %}in-[body:not(:has(#MenuDrawer))]:hidden{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- if s.action == 'menu' -%}
      <button type="button" class="{{ item_class }}" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false">
        {%- render 'icon', name: icon_name, class: 'size-6' -%}
        <span class="max-w-full truncate">{{ s.label | escape }}</span>
      </button>
    {%- else -%}
      <a
        href="{{ url }}"
        class="{{ item_class }}"
        {% if current %}
          aria-current="page"
        {% endif %}
        {% if drawer != blank %}
          data-drawer-open="{{ drawer }}" aria-controls="{{ drawer }}" aria-expanded="false"
        {% endif %}
        {% if s.action == 'link' and s.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        <span class="relative">
          {%- render 'icon', name: icon_name, class: 'size-6' -%}
          {%- if s.action == 'cart' -%}
            <span
              class="absolute -top-1.5 -end-2.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-primary px-1 text-[0.625rem] leading-none font-semibold text-on-primary"
              data-cart-count
              {% if cart.item_count == 0 %}
                hidden
              {% endif %}
            >
              {{- cart.item_count -}}
            </span>
          {%- endif -%}
        </span>
        <span class="max-w-full truncate">{{ s.label | escape }}</span>
      </a>
    {%- endif -%}
  </li>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.dock_item.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "action",
      "label": "t:blocks.dock_item.settings.action.label",
      "options": [
        { "value": "home", "label": "t:blocks.dock_item.settings.action.options.home" },
        { "value": "menu", "label": "t:blocks.dock_item.settings.action.options.menu" },
        { "value": "search", "label": "t:blocks.dock_item.settings.action.options.search" },
        { "value": "cart", "label": "t:blocks.dock_item.settings.action.options.cart" },
        { "value": "account", "label": "t:blocks.dock_item.settings.action.options.account" },
        { "value": "link", "label": "t:blocks.dock_item.settings.action.options.link" }
      ],
      "default": "link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.dock_item.settings.label.label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label",
      "visible_if": "{{ block.settings.action == 'link' }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:shared.icon_choice.label",
      "options": [
        { "value": "grid", "label": "t:shared.icon_choice.options.grid" },
        { "value": "tag", "label": "t:shared.icon_choice.options.tag" },
        { "value": "heart", "label": "t:shared.icon_choice.options.heart" },
        { "value": "star", "label": "t:shared.icon_choice.options.star" },
        { "value": "gift", "label": "t:shared.icon_choice.options.gift" },
        { "value": "chat", "label": "t:shared.icon_choice.options.chat" },
        { "value": "mail", "label": "t:shared.icon_choice.options.mail" },
        { "value": "phone", "label": "t:shared.icon_choice.options.phone" },
        { "value": "map-pin", "label": "t:shared.icon_choice.options.map_pin" },
        { "value": "box", "label": "t:shared.icon_choice.options.box" },
        { "value": "globe", "label": "t:shared.icon_choice.options.globe" }
      ],
      "default": "grid",
      "visible_if": "{{ block.settings.action == 'link' }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:blocks.dock_item.settings.open_in_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.action == 'link' }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.dock_item.name"
    }
  ]
}
{% endschema %}
