{% doc %}
  @description One column in a Multicolumn section: an image, an icon (built-in set or uploaded SVG/PNG) or no media, then a heading, rich text and an optional link. Card look, alignment, icon size / position and image ratio come from the section.
  Use when: only inside the "multicolumn" section.

  @example
  {% content_for 'block', type: '_column', id: 'column-1' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign ss = section.settings

  case ss.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'wide'
      assign ratio = '16 / 9'
    when 'natural'
      assign ratio = s.image.aspect_ratio | default: 1.5
    else
      assign ratio = '3 / 2'
  endcase

  case ss.columns
    when 2
      assign image_sizes = '(min-width: 750px) 50vw, 85vw'
    when 3
      assign image_sizes = '(min-width: 750px) 33vw, 85vw'
    else
      assign image_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 85vw'
  endcase

  assign has_icon = false
  if s.media == 'icon'
    if s.custom_icon != blank or s.icon != 'none'
      assign has_icon = true
    endif
  endif

  assign row_class = ''
  if has_icon
    assign row_class = 'in-data-[icon=start]:flex-row in-data-[icon=start]:items-start'
  endif

  assign image_alt = s.image.alt | escape
  assign icon_alt = s.custom_icon.alt | escape | default: ''
  assign title = s.heading
-%}
<li
  class="flex shrink-0 snap-start flex-col gap-4 in-data-[mobile=slider]:w-(--slide-w) md:in-data-[mobile=slider]:w-auto in-data-[align=center]:items-center in-data-[align=center]:text-center in-data-[card=bordered]:rounded-card in-data-[card=bordered]:border in-data-[card=bordered]:border-border in-data-[card=bordered]:p-5 in-data-[card=filled]:rounded-card in-data-[card=filled]:bg-fg/5 in-data-[card=filled]:p-5 md:in-data-[card=bordered]:p-7 md:in-data-[card=filled]:p-7 {{ row_class }}"
  {{ block.shopify_attributes }}
>
  {%- if s.media == 'image' -%}
    <div class="w-full overflow-hidden rounded-media bg-fg/5 aspect-(--column-ratio)" style="--column-ratio: {{ ratio }};">
      {%- if s.image != blank -%}
        {%- capture image_html -%}
          {{ s.image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 900, 1100, 1400', sizes: image_sizes, loading: 'lazy', class: 'size-full object-cover transition duration-500 hover:scale-[1.03]', alt: image_alt }}
        {%- endcapture -%}
        {%- if s.link != blank -%}
          <a href="{{ s.link }}" tabindex="-1" aria-hidden="true" class="block size-full">{{ image_html }}</a>
        {%- else -%}
          {{ image_html }}
        {%- endif -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'size-full bg-placeholder' }}
      {%- endif -%}
    </div>
  {%- elsif has_icon -%}
    <span class="flex shrink-0 items-center justify-center text-fg" aria-hidden="true">
      {%- if s.custom_icon != blank -%}
        {{ s.custom_icon | image_url: width: 200 | image_tag: class: 'size-(--icon-size) object-contain', alt: icon_alt, loading: 'lazy' }}
      {%- else -%}
        {%- render 'icon', name: s.icon, class: 'size-(--icon-size)' -%}
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if title != blank or s.text != blank or s.link_label != blank -%}
    <div class="flex min-w-0 flex-1 flex-col gap-2 in-data-[align=center]:items-center">
      {%- if title != blank -%}
        <h3 class="type-h5">
          {%- if s.link != blank -%}
            <a href="{{ s.link }}" class="no-underline hover:underline">{{ title }}</a>
          {%- else -%}
            {{ title }}
          {%- endif -%}
        </h3>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="rte type-sm text-muted">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.link_label != blank and s.link != blank -%}
        <a href="{{ s.link }}" class="btn btn-link mt-1 self-start in-data-[align=center]:self-center">
          {{- s.link_label | escape -}}
          {%- if title != blank -%}<span class="sr-only">: {{ title | strip_html }}</span>{%- endif -%}
          {%- render 'icon', name: 'arrow-right', class: 'size-4 rtl:rotate-180' -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</li>

{% schema %}
{
  "name": "t:blocks.column.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media",
      "label": "t:blocks.column.settings.media.label",
      "options": [
        {
          "value": "icon",
          "label": "t:blocks.column.settings.media.options.icon"
        },
        {
          "value": "image",
          "label": "t:blocks.column.settings.media.options.image"
        },
        {
          "value": "none",
          "label": "t:blocks.column.settings.media.options.none"
        }
      ],
      "default": "icon"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.column.settings.image.label",
      "visible_if": "{{ block.settings.media == 'image' }}"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:blocks.icon.settings.icon.label",
      "visible_if": "{{ block.settings.media == 'icon' }}",
      "options": [
        { "value": "none", "label": "t:blocks.icon.settings.icon.options.none" },
        { "value": "check", "label": "t:blocks.feature.settings.icon.options.check" },
        { "value": "star", "label": "t:blocks.feature.settings.icon.options.star" },
        { "value": "sparkle", "label": "t:blocks.icon.settings.icon.options.sparkle" },
        { "value": "heart", "label": "t:blocks.icon.settings.icon.options.heart" },
        { "value": "award", "label": "t:blocks.icon.settings.icon.options.award" },
        { "value": "shield", "label": "t:blocks.feature.settings.icon.options.shield" },
        { "value": "lock", "label": "t:blocks.feature.settings.icon.options.lock" },
        { "value": "truck", "label": "t:blocks.feature.settings.icon.options.truck" },
        { "value": "package", "label": "t:blocks.icon.settings.icon.options.package" },
        { "value": "return", "label": "t:blocks.feature.settings.icon.options.return" },
        { "value": "gift", "label": "t:blocks.icon.settings.icon.options.gift" },
        { "value": "tag", "label": "t:blocks.icon.settings.icon.options.tag" },
        { "value": "credit-card", "label": "t:blocks.icon.settings.icon.options.credit_card" },
        { "value": "chat", "label": "t:blocks.feature.settings.icon.options.chat" },
        { "value": "mail", "label": "t:blocks.icon.settings.icon.options.mail" },
        { "value": "phone", "label": "t:blocks.icon.settings.icon.options.phone" },
        { "value": "users", "label": "t:blocks.icon.settings.icon.options.users" },
        { "value": "clock", "label": "t:blocks.icon.settings.icon.options.clock" },
        { "value": "calendar", "label": "t:blocks.icon.settings.icon.options.calendar" },
        { "value": "map-pin", "label": "t:blocks.icon.settings.icon.options.map_pin" },
        { "value": "globe", "label": "t:blocks.feature.settings.icon.options.globe" },
        { "value": "leaf", "label": "t:blocks.icon.settings.icon.options.leaf" },
        { "value": "water", "label": "t:blocks.feature.settings.icon.options.water" },
        { "value": "bolt", "label": "t:blocks.feature.settings.icon.options.bolt" },
        { "value": "battery", "label": "t:blocks.feature.settings.icon.options.battery" },
        { "value": "bluetooth", "label": "t:blocks.feature.settings.icon.options.bluetooth" },
        { "value": "headphones", "label": "t:blocks.feature.settings.icon.options.headphones" },
        { "value": "speaker", "label": "t:blocks.feature.settings.icon.options.speaker" },
        { "value": "ruler", "label": "t:blocks.icon.settings.icon.options.ruler" }
      ],
      "default": "check"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:blocks.feature.settings.custom_icon.label",
      "info": "t:blocks.feature.settings.custom_icon.info",
      "visible_if": "{{ block.settings.media == 'icon' }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:shared.section_heading.heading",
      "default": "Add a heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "<p>Pair a short heading with one or two lines about a feature, a promise or a step.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label",
      "info": "t:blocks.column.settings.link.info"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.image_card.settings.link_label.label"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.column.name"
    }
  ]
}
{% endschema %}
