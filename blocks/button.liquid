{% doc %}
  @description Call-to-action link styled as a button (primary, secondary or text link). Renders a disabled button when no link is set so layouts stay visible in the editor.
  Use when: any clickable CTA such as "Shop now" or "Learn more".

  @example
  {% content_for 'block', type: 'button', id: 'cta' %}
{% enddoc %}
{%- liquid
  assign s = block.settings

  case s.style
    when 'secondary'
      assign style_class = 'btn btn-secondary'
    when 'link'
      assign style_class = 'btn btn-link'
    else
      assign style_class = 'btn btn-primary'
  endcase
-%}
{%- if s.link != blank -%}
  <a
    href="{{ s.link }}"
    class="{{ style_class }}"
    {% if s.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{- s.label | escape -}}
  </a>
{%- else -%}
  <span class="{{ style_class }}" aria-disabled="true" {{ block.shopify_attributes }}>
    {{- s.label | escape -}}
  </span>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button.settings.label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:blocks.button.settings.open_in_new_tab.label",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button.settings.style.label",
      "options": [
        { "value": "primary", "label": "t:blocks.button.settings.style.options.primary" },
        { "value": "secondary", "label": "t:blocks.button.settings.style.options.secondary" },
        { "value": "link", "label": "t:blocks.button.settings.style.options.link" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button.name"
    }
  ]
}
{% endschema %}
