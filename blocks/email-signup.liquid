{% doc %}
  @description Newsletter sign-up form as a block: optional heading and text, an email field that adds the shopper to Shopify customers with marketing consent (tagged "newsletter"), a text or arrow button, and an optional consent / privacy line under the field (e.g. a link to the privacy policy). Shows a thank-you message or the error under this form only after submitting.
  Use when: footer columns, inside groups on landing pages, anywhere a compact sign-up is needed (use the newsletter section for a full-width band).

  @example
  {% content_for 'block', type: 'email-signup', id: 'footer-signup' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign form_id = 'EmailSignup-' | append: block.id
-%}
<div class="flex w-full max-w-md flex-col gap-3" {{ block.shopify_attributes }}>
  {%- if s.heading != blank -%}
    <h2 class="type-h5">{{ s.heading | escape }}</h2>
  {%- endif -%}
  {%- if s.text != blank -%}
    <div class="rte type-sm text-muted">{{ s.text }}</div>
  {%- endif -%}
  {%- form 'customer', id: form_id, class: 'w-full' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      <p class="flex items-center gap-2 font-semibold text-success" role="status" tabindex="-1" autofocus>
        {%- render 'icon', name: 'check', class: 'size-5' -%}
        {{- 'sections.newsletter.success' | t -}}
      </p>
    {%- else -%}
      <div class="relative flex gap-2">
        <label for="{{ form_id }}-email" class="sr-only">{{ 'sections.newsletter.label' | t }}</label>
        <input
          type="email"
          id="{{ form_id }}-email"
          name="contact[email]"
          required
          autocomplete="email"
          placeholder="{{ 'sections.newsletter.label' | t }}"
          value="{{ form.email }}"
          class="field h-12 min-w-0 flex-1 {% if s.button_style == 'arrow' %}pe-14{% endif %}"
          {% if form.errors %}
            aria-invalid="true" aria-describedby="{{ form_id }}-error"
          {% elsif s.consent != blank %}
            aria-describedby="{{ form_id }}-consent"
          {% endif %}
        >
        {%- if s.button_style == 'arrow' -%}
          <button type="submit" class="btn btn-primary absolute inset-y-1 end-1 min-h-0 w-10 rounded-full px-0" aria-label="{{ 'sections.newsletter.submit' | t }}">
            {%- render 'icon', name: 'arrow-right', class: 'size-5 rtl:rotate-180' -%}
          </button>
        {%- else -%}
          <button type="submit" class="btn btn-primary h-12">{{ 'sections.newsletter.submit' | t }}</button>
        {%- endif -%}
      </div>
      {%- if form.errors -%}
        <p id="{{ form_id }}-error" class="mt-2 type-sm text-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
  {%- if s.consent != blank -%}
    <p id="{{ form_id }}-consent" class="type-xs text-muted [&_a]:underline">{{ s.consent }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.email_signup.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "Join the list"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.featured_collection.settings.text.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:blocks.email_signup.settings.button_style.label",
      "options": [
        { "value": "text", "label": "t:blocks.email_signup.settings.button_style.options.text" },
        { "value": "arrow", "label": "t:blocks.email_signup.settings.button_style.options.arrow" }
      ],
      "default": "text"
    },
    {
      "type": "inline_richtext",
      "id": "consent",
      "label": "t:blocks.email_signup.settings.consent.label",
      "info": "t:blocks.email_signup.settings.consent.info"
    }
  ],
  "presets": [{ "name": "t:blocks.email_signup.name" }]
}
{% endschema %}
