{% doc %}
  @description Countdown (days, hours, minutes, seconds) to a real end date stored on the product — a date and time metafield, custom.sale_ends by default. Shows nothing when the product has no date or the date has passed, and hides itself the moment it reaches zero. Never invents a deadline.
  Use when: product info column, for a genuine limited-time offer ("sale ends in", "pre-order closes in"). Create the metafield (type "Date and time") in Settings → Custom data → Products and fill it per product.

  @example
  {% content_for 'block', type: 'product-countdown', id: 'countdown' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign product = closest.product
  assign field_path = s.metafield | default: 'custom.sale_ends' | strip
  assign namespace = field_path | split: '.' | first
  assign key = field_path | split: '.' | last
  assign field = product.metafields[namespace][key]
  assign end_value = field.value | default: field
  assign end_seconds = 0
  if end_value != blank
    assign end_seconds = end_value | date: '%s' | plus: 0
  endif
  assign now_seconds = 'now' | date: '%s' | plus: 0

  assign surface_class = ''
  if s.use_color_scheme
    assign surface_class = 'surface-' | append: s.color_scheme
  endif
-%}
{%- if end_seconds > now_seconds -%}
  {%- assign end_text = end_value | date: format: 'date_at_time' -%}
  <aw-product-countdown
    class="flex flex-wrap items-center justify-between gap-3 rounded-card border border-border p-4 {{ surface_class }}"
    data-end="{{ end_seconds }}"
    {{ block.shopify_attributes }}
  >
    <div class="flex items-center gap-2">
      {%- render 'icon', name: 'clock', class: 'size-5' -%}
      <p class="type-sm font-semibold">{{ s.heading | escape }}</p>
    </div>
    <p class="sr-only">{{ 'blocks.product_countdown.ends_at' | t: date: end_text }}</p>
    <div class="flex gap-2" aria-hidden="true">
      {%- for unit in (1..4) -%}
        {%- case unit -%}
          {%- when 1 -%}
            {%- assign unit_ref = 'days' -%}
            {%- assign unit_label = 'blocks.product_countdown.days' | t -%}
          {%- when 2 -%}
            {%- assign unit_ref = 'hours' -%}
            {%- assign unit_label = 'blocks.product_countdown.hours' | t -%}
          {%- when 3 -%}
            {%- assign unit_ref = 'minutes' -%}
            {%- assign unit_label = 'blocks.product_countdown.minutes' | t -%}
          {%- else -%}
            {%- assign unit_ref = 'seconds' -%}
            {%- assign unit_label = 'blocks.product_countdown.seconds' | t -%}
        {%- endcase -%}
        <span class="flex min-w-12 flex-col items-center rounded-btn bg-fg/5 px-2 py-1">
          <span class="type-h5 tabular-nums" data-ref="{{ unit_ref }}">--</span>
          <span class="type-xs text-muted">{{ unit_label }}</span>
        </span>
      {%- endfor -%}
    </div>
  </aw-product-countdown>
  <script src="{{ 'c-product-countdown.js' | asset_url }}" type="module"></script>
{%- elsif request.design_mode -%}
  <p class="type-xs text-muted" {{ block.shopify_attributes }}>{{ 'blocks.product_countdown.empty' | t: field: field_path }}</p>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_countdown.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.product_countdown.settings.heading.label",
      "default": "Offer ends in"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "t:blocks.product_countdown.settings.metafield.label",
      "info": "t:blocks.product_countdown.settings.metafield.info",
      "default": "custom.sale_ends"
    },
    {
      "type": "checkbox",
      "id": "use_color_scheme",
      "label": "t:shared.use_color_scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.use_color_scheme }}"
    }
  ],
  "presets": [{ "name": "t:blocks.product_countdown.name" }]
}
{% endschema %}
