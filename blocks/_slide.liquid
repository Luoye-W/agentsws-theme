{% doc %}
  @description One slide of a Slideshow section: background image (separate mobile image optional) or muted looping Shopify video, darkening overlay, and any blocks (heading, text, buttons) placed in one of nine positions. An optional slide link makes the whole slide clickable; its accessible name is the link label, or the slide heading. When the section height is "Adapt to image", the first slide sets the slideshow ratio from its own image. In the section's "peek" layout the slide is inset with rounded corners (styled by the section); with the section's transparent header the content moves below the header.
  Use when: only inside the "slideshow" section.

  @example
  {% content_for 'block', type: '_slide', id: 'slide-1' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign slide_count = section.blocks.size
  assign slide_index = 1
  for item in section.blocks
    if item.id == block.id
      assign slide_index = forloop.index
      break
    endif
  endfor

  assign desktop_image = s.image
  assign mobile_image = s.image_mobile | default: s.image
  assign image_alt = desktop_image.alt | escape

  assign loading = 'lazy'
  assign fetch_priority = 'low'
  if slide_index == 1 and section.index <= 2
    assign loading = 'eager'
    assign fetch_priority = 'high'
  elsif slide_index == 1
    assign fetch_priority = 'auto'
  endif

  case s.position
    when 'top_left'
      assign position_class = 'md:items-start md:justify-start md:text-start'
    when 'top_center'
      assign position_class = 'md:items-start md:justify-center md:text-center'
    when 'top_right'
      assign position_class = 'md:items-start md:justify-end md:text-end'
    when 'middle_left'
      assign position_class = 'md:items-center md:justify-start md:text-start'
    when 'middle_right'
      assign position_class = 'md:items-center md:justify-end md:text-end'
    when 'bottom_left'
      assign position_class = 'md:items-end md:justify-start md:text-start'
    when 'bottom_center'
      assign position_class = 'md:items-end md:justify-center md:text-center'
    when 'bottom_right'
      assign position_class = 'md:items-end md:justify-end md:text-end'
    else
      assign position_class = 'md:items-center md:justify-center md:text-center'
  endcase

  case s.mobile_position
    when 'top'
      assign mobile_position_class = 'items-start'
    when 'bottom'
      assign mobile_position_class = 'items-end'
    else
      assign mobile_position_class = 'items-center'
  endcase

  case s.content_align
    when 'start'
      assign content_align_class = 'items-start'
    when 'end'
      assign content_align_class = 'items-end'
    else
      assign content_align_class = 'items-center'
  endcase

  assign content_id = 'SlideContent-' | append: block.id

  comment
    With a transparent header on top (section setting, first section only) the content moves down by the header height.
  endcomment
  if section.settings.transparent_header
    assign content_padding_class = 'pt-[calc(3rem+var(--transparent-header-offset,0px))] pb-24 md:pt-[calc(5rem+var(--transparent-header-offset,0px))] md:pb-28'
  else
    assign content_padding_class = 'pt-12 pb-24 md:pt-20 md:pb-28'
  endif
-%}
<div
  id="Slide-{{ block.id }}"
  class="relative isolate flex w-full shrink-0 snap-start overflow-hidden min-h-(--slide-min-h-mobile) md:min-h-(--slide-min-h) aspect-(--slide-ratio-mobile) md:aspect-(--slide-ratio)"
  style="--slide-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};"
  role="group"
  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
  aria-label="{{ 'sections.slideshow.slide_position' | t: index: slide_index, count: slide_count }}"
  data-ref="slide"
  data-index="{{ slide_index | minus: 1 }}"
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {%- if slide_index == 1 and section.settings.height == 'adapt' -%}
    {%- liquid
      assign adapt_ratio = desktop_image.aspect_ratio | default: 2
      assign adapt_ratio_mobile = mobile_image.aspect_ratio | default: 0.75
    -%}
    <style>
      #SlideshowTrack-{{ section.id }} { --slide-ratio: {{ adapt_ratio }}; --slide-ratio-mobile: {{ adapt_ratio_mobile }}; }
    </style>
  {%- endif -%}
  <div class="absolute inset-0 -z-10 bg-placeholder">
    {%- if s.video != blank -%}
      <div class="size-full" data-ref="slide-video">
        {{
          s.video
          | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '2400x', class: 'size-full object-cover'
        }}
      </div>
    {%- elsif desktop_image != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w"
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2400, 3000',
            sizes: '100vw',
            loading: loading,
            fetchpriority: fetch_priority,
            class: 'size-full object-cover',
            alt: image_alt
        }}
      </picture>
    {%- else -%}
      {%- assign placeholder_index = slide_index | modulo: 2 | plus: 1 -%}
      {%- assign placeholder_name = 'lifestyle-' | append: placeholder_index -%}
      {{ placeholder_name | placeholder_svg_tag: 'size-full object-cover opacity-50' }}
    {%- endif -%}
    <div class="absolute inset-0 bg-[rgb(0_0_0/var(--slide-overlay))]" aria-hidden="true"></div>
  </div>

  {%- if s.link != blank -%}
    <a
      href="{{ s.link }}"
      class="absolute inset-0 z-[1] focus-visible:-outline-offset-4"
      data-ref="slide-link"
      {% if s.link_label != blank %}
        aria-label="{{ s.link_label | escape }}"
      {% endif %}
      {% if s.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      {%- unless s.link_label != blank -%}
        <span class="sr-only" data-ref="slide-link-fallback">{{ 'sections.slideshow.slide_link' | t: index: slide_index }}</span>
      {%- endunless -%}
    </a>
  {%- endif -%}

  <div class="pointer-events-none relative z-[2] flex w-full page-width {{ content_padding_class }} {{ mobile_position_class }} justify-center text-center {{ position_class }}">
    <div
      id="{{ content_id }}"
      class="surface-{{ s.text_color_scheme }} flex max-w-2xl flex-col gap-5 bg-transparent {{ content_align_class }} [&_a]:pointer-events-auto [&_button]:pointer-events-auto [&_input]:pointer-events-auto"
      data-heading-highlight="{{ section.settings.heading_highlight }}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.slide.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero.settings.image_mobile.label",
      "info": "t:sections.hero.settings.image_mobile.info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:blocks.slide.settings.video.label",
      "info": "t:blocks.slide.settings.video.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.hero.settings.content_header"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.hero.settings.position.label",
      "options": [
        { "value": "top_left", "label": "t:sections.hero.settings.position.options.top_left" },
        { "value": "top_center", "label": "t:sections.hero.settings.position.options.top_center" },
        { "value": "top_right", "label": "t:sections.hero.settings.position.options.top_right" },
        { "value": "middle_left", "label": "t:sections.hero.settings.position.options.middle_left" },
        { "value": "middle_center", "label": "t:sections.hero.settings.position.options.middle_center" },
        { "value": "middle_right", "label": "t:sections.hero.settings.position.options.middle_right" },
        { "value": "bottom_left", "label": "t:sections.hero.settings.position.options.bottom_left" },
        { "value": "bottom_center", "label": "t:sections.hero.settings.position.options.bottom_center" },
        { "value": "bottom_right", "label": "t:sections.hero.settings.position.options.bottom_right" }
      ],
      "default": "middle_center"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "t:sections.hero.settings.mobile_position.label",
      "options": [
        { "value": "top", "label": "t:sections.hero.settings.mobile_position.options.top" },
        { "value": "middle", "label": "t:sections.hero.settings.mobile_position.options.middle" },
        { "value": "bottom", "label": "t:sections.hero.settings.mobile_position.options.bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:sections.hero.settings.content_align.label",
      "options": [
        { "value": "start", "label": "t:shared.align.options.start" },
        { "value": "center", "label": "t:shared.align.options.center" },
        { "value": "end", "label": "t:shared.align.options.end" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "text_color_scheme",
      "label": "t:sections.hero.settings.text_surface.label",
      "info": "t:sections.hero.settings.text_surface.info",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:blocks.slide.settings.link_header"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.slide.settings.link.label",
      "info": "t:blocks.slide.settings.link.info"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:blocks.slide.settings.link_label.label",
      "info": "t:blocks.slide.settings.link_label.info",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:blocks.button.settings.open_in_new_tab.label",
      "default": false,
      "visible_if": "{{ block.settings.link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.slide.name",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Slide headline",
            "size": "display",
            "tag": "h2",
            "alignment": "center"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Tell shoppers what this slide is about.</p>",
            "size": "lg",
            "alignment": "center"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
