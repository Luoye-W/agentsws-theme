{% doc %}
  @description Product highlights: a short list of icon + text lines ("Waterproof to 30 m", "2-year warranty"). Either add up to 6 rows as child blocks, or read them per product from a metafield — list of single line texts (custom.highlights by default), one line per item written "icon: text", e.g. "truck: Ships in 24 hours". Icon names: check, truck, return, shield, lock, chat, star, globe, gift, leaf, clock, pin, ruler, info, bolt, battery, water, headphones; lines without a known icon get a check mark. Hidden when empty. On the main product page the list can sit below the images on desktop (Placement).
  Use when: key selling points next to the buy buttons; product-specific highlights maintained in admin (metafield mode).

  @example
  {% content_for 'block', type: 'product-icon-list', id: 'highlights' %}
{% enddoc %}
{%- liquid
  assign s = block.settings
  assign product = closest.product

  if s.columns == '2'
    assign list_class = 'grid grid-cols-1 gap-x-6 gap-y-3 md:grid-cols-2'
  else
    assign list_class = 'flex flex-col gap-3'
  endif
  if s.text_size == 'body'
    assign size_class = 'type-body'
  else
    assign size_class = 'type-sm'
  endif

  assign below = false
  if s.placement == 'below_media'
    for top_block in section.blocks
      if top_block.id == block.id
        assign below = true
        break
      endif
    endfor
  endif

  assign items_html = ''
  if s.source == 'metafield'
    assign field_path = s.metafield | default: 'custom.highlights' | strip
    capture items_html
      render 'highlight-items', product: product, field: field_path, limit: 12, item_class: 'flex items-start gap-3', icon_class: 'mt-0.5 size-[var(--icon-size,1.25rem)]'
    endcapture
  endif
-%}
{%- if below -%}<!--aw:below-media-->{%- endif -%}
{%- if s.source == 'metafield' -%}
  {%- if items_html != blank -%}
    <div class="flex flex-col gap-3" style="--icon-size: {{ s.icon_size }}px;" {{ block.shopify_attributes }}>
      {%- if s.heading != blank -%}
        <h2 class="type-h6">{{ s.heading | escape }}</h2>
      {%- endif -%}
      <ul class="{{ list_class }} {{ size_class }}" role="list">
        {{ items_html }}
      </ul>
    </div>
  {%- elsif request.design_mode -%}
    <p class="type-xs text-muted" {{ block.shopify_attributes }}>{{ 'blocks.product_icon_list.empty' | t: field: field_path }}</p>
  {%- endif -%}
{%- else -%}
  <div class="flex flex-col gap-3" style="--icon-size: {{ s.icon_size }}px;" {{ block.shopify_attributes }}>
    {%- if s.heading != blank -%}
      <h2 class="type-h6">{{ s.heading | escape }}</h2>
    {%- endif -%}
    <ul class="{{ list_class }} {{ size_class }}" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
{%- endif -%}
{%- if below -%}<!--/aw:below-media-->{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_icon_list.name",
  "tag": null,
  "blocks": [{ "type": "_product-icon-item" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.product_icon_list.settings.heading.label"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:blocks.product_icon_list.settings.source.label",
      "options": [
        { "value": "blocks", "label": "t:blocks.product_icon_list.settings.source.options.blocks" },
        { "value": "metafield", "label": "t:blocks.product_icon_list.settings.source.options.metafield" }
      ],
      "default": "blocks"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "t:blocks.product_icon_list.settings.metafield.label",
      "info": "t:blocks.product_icon_list.settings.metafield.info",
      "default": "custom.highlights",
      "visible_if": "{{ block.settings.source == 'metafield' }}"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.product_icon_list.settings.blocks_info"
    },
    {
      "type": "select",
      "id": "placement",
      "label": "t:blocks.product_spec_tiles.settings.placement.label",
      "info": "t:blocks.product_spec_tiles.settings.placement.info",
      "options": [
        { "value": "info", "label": "t:blocks.product_spec_tiles.settings.placement.options.info" },
        { "value": "below_media", "label": "t:blocks.product_spec_tiles.settings.placement.options.below_media" }
      ],
      "default": "info"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:blocks.product_icon_list.settings.columns.label",
      "options": [
        { "value": "1", "label": "t:shared.columns_mobile.options.one" },
        { "value": "2", "label": "t:shared.columns_mobile.options.two" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:blocks.product_icon_list.settings.icon_size.label",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:blocks.product_icon_list.settings.text_size.label",
      "options": [
        { "value": "sm", "label": "t:blocks.product_icon_list.settings.text_size.options.sm" },
        { "value": "body", "label": "t:blocks.product_icon_list.settings.text_size.options.body" }
      ],
      "default": "sm"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_icon_list.name",
      "blocks": {
        "item-1": { "type": "_product-icon-item", "settings": { "icon": "check", "text": "Add a key product benefit" } },
        "item-2": { "type": "_product-icon-item", "settings": { "icon": "check", "text": "Add a second benefit" } },
        "item-3": { "type": "_product-icon-item", "settings": { "icon": "check", "text": "Add a third benefit" } }
      },
      "block_order": ["item-1", "item-2", "item-3"]
    }
  ]
}
{% endschema %}
