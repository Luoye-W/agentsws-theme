<!doctype html>
{%- liquid
  assign locale_root = request.locale.iso_code | split: '-' | first
  assign rtl_locales = 'ar,he,fa,ur,ps,sd,yi,ug,ku' | split: ','
  assign text_direction = 'ltr'
  if rtl_locales contains locale_root
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif %}
    <title>{{ shop.name }}</title>
    {%- if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}
    {% render 'meta-tags' %}
    {% render 'theme-tokens' %}
    {{ 'app.css' | asset_url | stylesheet_tag }}
    <script type="importmap">
      {
        "imports": {
          "@aw/component": "{{ 'component.js' | asset_url }}",
          "@aw/events": "{{ 'events.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>
    {{ content_for_header }}
  </head>

  <body class="surface-{{ settings.body_color_scheme }} font-body" data-button-style="{{ settings.button_style }}" data-button-hover="{{ settings.button_hover }}">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-50 btn btn-primary" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>
    {%- comment -%} The password section renders its own top bar, <main id="MainContent"> and footer. {%- endcomment -%}
    {{ content_for_layout }}
  </body>
</html>
